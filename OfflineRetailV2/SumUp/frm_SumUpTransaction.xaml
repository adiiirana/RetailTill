<Window x:Class="OfflineRetailV2.SumUp.frm_SumUpTransaction"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        mc:Ignorable="d"
        Title="frm_SumUpTransaction" Height="200" Width="400" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent" Loaded="Window_Loaded" Closing="Window_Closing">
    <!-- Same look and flow as the EVO "Card payment" window (XeposExternal\frm_EvoTransaction.xaml). -->
    <cc:ModalWindowWC x:Name="ModalWindowWC">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="9"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="9"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Name="TitleTextBlock" TextWrapping="WrapWithOverflow" Style="{DynamicResource BlueHeading}"
                       Text="Card payment" FontSize="15" FontFamily="{DynamicResource OSRegular}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Center" Fill="#6F889A" Margin="-5,0"/>
            <TextBlock Grid.Row="2" x:Name="ContentTextBlock" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>
            <Button Grid.Row="4" Height="42" x:Name="CloseButton" Margin="33,0" Style="{DynamicResource SaveButtonBoldStyle}"
                    Content="Cancel" Visibility="Hidden" Click="CloseButton_Click"/>
        </Grid>
    </cc:ModalWindowWC>
</Window>
