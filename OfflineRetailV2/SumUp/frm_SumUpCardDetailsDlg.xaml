<Window x:Class="OfflineRetailV2.SumUp.frm_SumUpCardDetailsDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        mc:Ignorable="d"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent" WindowStartupLocation="CenterScreen"
        Title="" Foreground="White" Width="640" Height="440" Topmost="True">
    <!-- Same layout as the XEPOS POS dialogs (e.g. frm_POSPaidOutDlg): heading with CANCEL / DONE-style buttons, line, fields. -->
    <cc:ModalWindow x:Name="ModalWindow">
        <Grid Margin="9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="9"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Card Details" x:Name="TitleText" VerticalAlignment="Center" Style="{DynamicResource BlueHeading}"/>
            <Grid HorizontalAlignment="Right" Margin="0,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="9"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="9"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button IsTabStop="False" Focusable="False" Grid.Column="0" Content="TEST CARD" x:Name="btnTestCard"
                        FontFamily="{StaticResource OSSemiBold}" Style="{DynamicResource GeneralButtonStyle}" Height="35" Width="120" Click="BtnTestCard_Click"/>
                <Button IsTabStop="False" Focusable="False" Grid.Column="2" Content="CANCEL" x:Name="btnCancel"
                        FontFamily="{StaticResource OSSemiBold}" Style="{DynamicResource CancelButtonStyle}" Height="35" Width="120" Click="BtnCancel_Click"/>
                <Button IsTabStop="False" Focusable="False" Grid.Column="4" Content="PAY" x:Name="btnPay"
                        FontFamily="{StaticResource OSSemiBold}" Style="{DynamicResource SaveButtonStyle}" Height="35" Width="120" Click="BtnPay_Click"/>
            </Grid>

            <Rectangle Grid.Row="1" Style="{DynamicResource DefaultLineStyle}" VerticalAlignment="Center" Margin="-9,0"/>

            <Grid Grid.Row="2" Margin="0,9,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="9"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="9"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="9"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="13"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="13"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Amount to pay -->
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Amount" FontFamily="{StaticResource OSSemiBold}" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" x:Name="lbAmount" Text="£ 0.00" FontFamily="{StaticResource OSSemiBold}" FontSize="18"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Text="Cardholder Name"/>
                <dxe:TextEdit Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" x:Name="txtName" MaxLength="100"
                              GotFocus="Text_GotFocus" LostFocus="Edit_LostFocus"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5" Text="Card Number"/>
                <dxe:TextEdit Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="5" x:Name="txtNumber" MaxLength="23" InputScope="Number"
                              GotFocus="Number_GotFocus" LostFocus="Edit_LostFocus"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Expiry Month (MM)"/>
                <TextBlock Grid.Row="10" Grid.Column="2" Text="Expiry Year (YY)"/>
                <TextBlock Grid.Row="10" Grid.Column="4" Text="CVV"/>
                <dxe:TextEdit Grid.Row="12" Grid.Column="0" x:Name="txtMonth" MaxLength="2" InputScope="Number" GotFocus="Number_GotFocus" LostFocus="Edit_LostFocus"/>
                <dxe:TextEdit Grid.Row="12" Grid.Column="2" x:Name="txtYear" MaxLength="2" InputScope="Number" GotFocus="Number_GotFocus" LostFocus="Edit_LostFocus"/>
                <dxe:PasswordBoxEdit Grid.Row="12" Grid.Column="4" x:Name="txtCvv" MaxLength="4" GotFocus="Number_GotFocus" LostFocus="Edit_LostFocus"/>

                <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="5" VerticalAlignment="Bottom">
                    <TextBlock x:Name="lbStatus" TextWrapping="Wrap" FontFamily="{StaticResource OSSemiBold}" FontSize="13" Foreground="#E05A4F" Margin="0,0,0,4"/>
                    <TextBlock x:Name="lbNote" TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                               Text="SumUp sandbox test payments only. Never enter a real customer card here: take live payments on the card reader."/>
                </StackPanel>
            </Grid>
        </Grid>
    </cc:ModalWindow>
</Window>
