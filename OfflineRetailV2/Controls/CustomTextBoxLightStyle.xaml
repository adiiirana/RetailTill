<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:OfflineRetailV2.Controls">

    <Style TargetType="{x:Type local:CustomTextBox}"  BasedOn="{StaticResource {x:Type TextBox}}" >
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#8A8A8A" />
        <Setter Property="BorderBrush" Value="#E1ECEA" />
        <Setter Property="SelectionBrush" Value="WhiteSmoke" />
        <Setter Property="CaretBrush" Value="WhiteSmoke" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource OSSemiBold}" />
        <Setter Property="ToolTip" Value="{x:Null}" />


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CustomTextBox}">
                    <Border
                        Margin="{TemplateBinding Margin}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <DockPanel LastChildFill="True" Margin="{TemplateBinding Padding}">
                            <Image Width="20" Height="19" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="0,0,8,0" x:Name="Icon"
                                   Source="{TemplateBinding Icon}" DockPanel.Dock="Left"/>
                            <Path x:Name="IconRight"
                                  Width="18" Height="18"
                                  Margin="4,0,0,0"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Fill="#5BA3E0"
                                  Visibility="Collapsed"
                                  DockPanel.Dock="Right"
                                  Data="M9.5,3C5.91,3 3,5.91 3,9.5C3,13.09 5.91,16 9.5,16C11.11,16 12.57,15.41 13.71,14.43L14,14.7V15.5L19,20.49L20.49,19L15.5,14H14.7L14.43,13.71C15.41,12.57 16,11.11 16,9.5C16,5.91 13.09,3 9.5,3z M9.5,5C11.99,5 14,7.01 14,9.5C14,11.99 11.99,14 9.5,14C7.01,14 5,11.99 5,9.5C5,7.01 7.01,5 9.5,5z"/>
                            <Grid>
                                <TextBlock
                                x:Name="InfoTextBlock" Margin="0,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Text="{TemplateBinding InfoText}"/>
                                <ScrollViewer
                                x:Name="PART_ContentHost" Margin="-2,0"
                                Focusable="false" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter Property="Visibility" TargetName="Icon" Value="Collapsed"/>
                            <Setter Property="Visibility" TargetName="IconRight" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IconOnRight" Value="True">
                            <Setter Property="Visibility" TargetName="Icon" Value="Collapsed"/>
                            <Setter Property="Visibility" TargetName="IconRight" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Icon" Value="{x:Null}"/>
                                <Condition Property="IconOnRight" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" TargetName="IconRight" Value="Collapsed"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>