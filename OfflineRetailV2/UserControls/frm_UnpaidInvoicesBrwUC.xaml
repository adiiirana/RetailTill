<UserControl x:Class="OfflineRetailV2.UserControls.frm_UnpaidInvoicesBrwUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OfflineRetailV2.UserControls"
             xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
             xmlns:lm="clr-namespace:OfflineRetailV2.LayoutManager"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d"    
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Grid.Row="2" Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="{DynamicResource Back}" Height="35" Width="35" x:Name="btnBack" PreviewMouseLeftButtonDown="btnBack_PreviewMouseLeftButtonDown"></Image>

            <Button Height="35" Width="150" Grid.Column="2" x:Name="btnCreateSimpleInvoice"
                    Style="{DynamicResource GeneralButtonStyle}" Content="Create Simple Invoice" Click="btnCreateSimpleInvoice_Click"/>

            <Button Height="35" Width="150" Grid.Column="4" x:Name="btnCreateCustomInvoice"
                    Style="{DynamicResource GeneralButtonStyle}" Content="Create Custom Invoice" Click="btnCreateCustomInvoice_Click" />
        </Grid>

        <Rectangle Grid.Row="1" VerticalAlignment="Center" Height="1" Style="{DynamicResource DefaultLineStyle}" Margin="0,5" />

        <Grid x:Name="bar2" Grid.Row="2" Margin="3,0,3,5">
            <cc:CustomTextBox HorizontalAlignment="Stretch" Height="30" BorderThickness="1" CornerRadius="0"
                              InfoText="Search Unpaid Invoices" Icon="{DynamicResource Search}" FontSize="13" 
                              FontFamily="{DynamicResource OSSemiBold}" x:Name="txtSearchGrdData" 
                              TextChanged="TxtSearchGrdData_TextChanged" />
        </Grid>

        <dxg:GridControl Grid.Row="3" ShowBorder="False" x:Name="grdUnpaidInvoices">
            <dxg:GridControl.View>
                <dxg:TableView x:Name="gridViewUnpaid" NavigationStyle="Row" ShowTotalSummary="False" 
                               ShowFilterPanelMode="Never" AllowColumnFiltering="False"/>
            </dxg:GridControl.View>
            <dxg:GridColumn FieldName="ID" Header="ID" Width="*" x:Name="colID" Visible="False"/>
            <dxg:GridColumn FieldName="InvoiceID" Header="Invoice ID" Width="0.8*"/>
            <dxg:GridColumn FieldName="Date" Header="Date" Width="1*"/>
            <dxg:GridColumn FieldName="Customer" Header="Customer" Width="1.5*"/>
            <dxg:GridColumn FieldName="Total" Header="Total" Width="0.8*"/>
            <dxg:GridColumn FieldName="AmountDue" Header="Amount Due" Width="1*"/>
            <dxg:GridColumn FieldName="AssignedStaff" Header="Assigned Staff" Width="1.2*"/>
            <dxg:GridColumn FieldName="FirstItem" Header="First Item" Width="2*"/>
            <dxg:GridColumn FieldName="PaymentStatus" Header="Payment Status" Width="1*"/>
        </dxg:GridControl>
    </Grid>
</UserControl>