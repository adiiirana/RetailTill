<Window x:Class="OfflineRetailV2.UserControls.POSSection.AddProductWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:data="clr-namespace:OfflineRetailV2.Data"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" 
        FocusVisualStyle="{x:Null}">

    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="dxe:TextEdit">
                <Setter Property="Height" Value="38"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource scBorderBrush}"/>
                <Setter Property="Background" Value="{DynamicResource scControlBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource scTextPrimaryBrush}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10,0,10,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="dxg:LookUpEdit">
                <Setter Property="Height" Value="38"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource scBorderBrush}"/>
                <Setter Property="Background" Value="{DynamicResource scControlBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource scTextPrimaryBrush}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10,0,10,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="LinkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource scPrimaryGreenBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextDecorations="Underline"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource scPrimaryGreenHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource scTextInverseBrush}"/>
                <Setter Property="Background" Value="{DynamicResource scPrimaryGreenBrush}"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="6" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource scPrimaryGreenHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource scPrimaryGreenPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource scTextPrimaryBrush}"/>
                <Setter Property="Background" Value="{DynamicResource scSecondaryButtonBrush}"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="6" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource scSecondaryButtonHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="KeypadButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource scKeypadBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource scBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource scTextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="3"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    CornerRadius="6" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.05" Color="Black"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource scKeypadHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource scBorderBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="InfoButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Background" Value="{DynamicResource scPrimaryGreenBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Path Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <EllipseGeometry Center="-0.8, -7" RadiusX="2.5" RadiusY="2.5"/>
                                            <RectangleGeometry Rect="-2.0, -1.5, 3.0, 8.5"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                    <Path.LayoutTransform>
                                        <TransformGroup>
                                            <SkewTransform AngleX="-14" CenterX="0" CenterY="0"/>
                                            <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                                            <TranslateTransform Y="3"/>
                                        </TransformGroup>
                                    </Path.LayoutTransform>
                                </Path>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource scPrimaryGreenHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type data:CustomToggleSwitch}">
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type data:CustomToggleSwitch}">
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Background="Transparent">
                                <Border x:Name="PART_SwitchTrack" Width="46" Height="24" CornerRadius="12" Background="{TemplateBinding Background}"/>
                                <Border x:Name="PART_SwitchThumb" Width="18" Height="18" CornerRadius="9" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.2"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border Background="#44000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
            <Border CornerRadius="15" Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.2" Color="Black"/>
                </Border.Effect>
            </Border>

            <cc:ModalWindow x:Name="ModalWindow" Margin="5">
                <Border Background="{DynamicResource scWindowBackgroundBrush}" CornerRadius="15" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,7">
                            <TextBlock Text="Add Item" Foreground="{DynamicResource scTextSecondaryBrush}" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource PoppinsBold}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Enter details for quick add" Foreground="{DynamicResource scTextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <StackPanel Margin="0,0,0,10">
                                <dxe:TextEdit x:Name="txtPrice" 
                              Background="{StaticResource scPriceInput}" 
                              Foreground="{DynamicResource scTextSecondaryBrush}"
                              IsReadOnly="True"
                              FontWeight="Bold"
                              FontSize="26" 
                              Height="50"
                              CornerRadius="8"
                              BorderThickness="2"
                              BorderBrush="{DynamicResource scBorderBrush}"
                              HorizontalContentAlignment="Center"
                              Focusable="False"
                              >
                                </dxe:TextEdit>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <StackPanel Grid.Column="0" Margin="0,0,8,0" Visibility="Collapsed">
                                    <TextBlock Text="SKU" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource scTextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <dxe:TextEdit x:Name="txtSKU" GotFocus="Full_GotFocus" LostFocus="Full_LostFocus" MaxLength="16"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,0,0">
                                    <TextBlock Text="Item Name" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource scTextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <dxe:TextEdit x:Name="txtDesc" Foreground="{DynamicResource scTextSecondaryBrush}" GotFocus="Full_GotFocus" LostFocus="Full_LostFocus" MaxLength="150"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Category" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource scTextSecondaryBrush}" Margin="0,0,0,3"/>
                                <dxg:LookUpEdit x:Name="cmbCategory"
                DisplayMember="Description"
                ValueMember="ID"
                AutoPopulateColumns="False"
                AutoComplete="True"
                IncrementalFiltering="True"
                                                Foreground="{DynamicResource scTextSecondaryBrush}"
                ImmediatePopup="True"
                IsPopupAutoWidth="False"
                ValidateOnTextInput="True"
                
                AllowNullInput="True"
                EditValuePostMode="Immediate"
                PopupWidth="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                PreviewMouseLeftButtonDown="CmbCategory_PreviewMouseLeftButtonDown">

                                    <dxg:LookUpEdit.PopupContentTemplate>
                                        <ControlTemplate>
                                            <dxg:GridControl Name="PART_GridControl">
                                                <dxg:GridControl.Columns>
                                                    <dxg:GridColumn FieldName="ID" Visible="False"/>
                                                    <dxg:GridColumn FieldName="ParentCategory" Visible="False"/>
                                                    <dxg:GridColumn FieldName="Description" Header="Category Name"/>
                                                </dxg:GridControl.Columns>
                                                <dxg:GridControl.View>
                                                    <dxg:TreeListView KeyFieldName="ID"
                                      ParentFieldName="ParentCategory"
                                      TreeDerivationMode="Selfreference"
                                      AutoExpandAllNodes="True"
                                      ShowColumnHeaders="False"
                                      ShowVerticalLines="False"
                                      ShowHorizontalLines="False"
                                      ShowIndicator="False"
                                      AutoWidth="True"/>
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxg:LookUpEdit.PopupContentTemplate>

                                    <dxg:LookUpEdit.PopupBottomAreaTemplate>
                                        <ControlTemplate>
                                            <Button Margin="0" Height="30" HorizontalAlignment="Stretch" 
                    Background="{DynamicResource scPrimaryGreenBrush}" BorderThickness="0" Cursor="Hand" 
                    Click="addCategorybtn_click">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="+ Add New Category" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource scTextInverseBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </ControlTemplate>
                                    </dxg:LookUpEdit.PopupBottomAreaTemplate>

                                </dxg:LookUpEdit>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <data:CustomToggleSwitch x:Name="chkPOSScreen" 
                                                                     OnBackground="{DynamicResource scPrimaryGreenBrush}" 
                                                                     OffBackground="{DynamicResource scSecondaryButtonBrush}"/>
                                            <TextBlock Text="Main Screen" VerticalAlignment="Center" FontFamily="{StaticResource PoppinsSemiBold}" 
                                                       FontSize="13" Margin="8,0,0,0" Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                            <Button Click="btnInfoMainScreen_Click" Style="{StaticResource InfoButtonStyle}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <data:CustomToggleSwitch x:Name="chkPOSCatScreen" IsChecked="True" 
                                                                     OnBackground="{DynamicResource scPrimaryGreenBrush}" 
                                                                     OffBackground="{DynamicResource scSecondaryButtonBrush}"/>
                                            <TextBlock Text="Category" VerticalAlignment="Center" FontFamily="{StaticResource PoppinsSemiBold}" 
                                                       FontSize="13" Margin="8,0,0,0" Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                            <Button Click="btnInfoCategory_Click" Style="{StaticResource InfoButtonStyle}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Content="ADVANCED" x:Name="btnAdvance" Grid.Column="1" 
                                            Style="{StaticResource LinkButtonStyle}" FontSize="14" 
                                            VerticalAlignment="Center" Margin="0,30,0,0" Click="btnAdvance_Click_1"/>
                                </Grid>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource KeypadButtonStyle}" Tag="1" Click="KeypadBtn_Click"/>
                                <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource KeypadButtonStyle}" Tag="2" Click="KeypadBtn_Click"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource KeypadButtonStyle}" Tag="3" Click="KeypadBtn_Click"/>

                                <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource KeypadButtonStyle}" Tag="4" Click="KeypadBtn_Click"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource KeypadButtonStyle}" Tag="5" Click="KeypadBtn_Click"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource KeypadButtonStyle}" Tag="6" Click="KeypadBtn_Click"/>

                                <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource KeypadButtonStyle}" Tag="7" Click="KeypadBtn_Click"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource KeypadButtonStyle}" Tag="8" Click="KeypadBtn_Click"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource KeypadButtonStyle}" Tag="9" Click="KeypadBtn_Click"/>

                                <Button Grid.Row="3" Grid.Column="0" Content="." Style="{StaticResource KeypadButtonStyle}" Tag="." Click="KeypadBtn_Click"/>
                                <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource KeypadButtonStyle}" Tag="0" Click="KeypadBtn_Click"/>
                                <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="KeypadBack_Click">
                                    <Path Data="M19,15.59L17.59,17L14,13.41L10.41,17L9,15.59L12.59,12L9,8.41L10.41,7L14,10.59L17.59,7L19,8.41L15.41,12L19,15.59M22,3A2,2 0 0,1 24,5V19A2,2 0 0,1 22,21H7C6.31,21 5.77,20.64 5.41,20.11L0,12L5.41,3.88C5.77,3.35 6.31,3 7,3H22Z" 
                                          Fill="{DynamicResource scTextPrimaryBrush}" Height="16" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnOK"
                                    Grid.Column="0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Foreground="White"
                                    Margin="0,0,10,0" Click="btnOK_Click_1">
                                <TextBlock Text="SAVE ITEM" 
                                           Foreground="White" 
                                           FontFamily="{StaticResource PoppinsRegular}" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"/>
                            </Button>

                            <Button x:Name="btnCancel"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="125" Click="btnCancel_Click_1">
                                <TextBlock Text="Cancel" 
                                           FontFamily="{StaticResource PoppinsRegular}" 
                                           Foreground="{DynamicResource scTextSecondaryBrush}"
                                           FontSize="14"/>
                            </Button>
                        </Grid>

                        <StackPanel Visibility="Collapsed">
                            <dxe:ComboBoxEdit x:Name="cmbProductType"/>
                            <dxg:LookUpEdit x:Name="cmbDept"/>
                            <dxe:ToggleSwitch x:Name="chkActive" IsChecked="True"/>
                        </StackPanel>

                        <Popup x:Name="popupHotKey" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource scWindowBackgroundBrush}" BorderBrush="{DynamicResource scBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" MaxWidth="320">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource scTextPrimaryBrush}" FontSize="13" Text="Display this item on the POS main screen, Under its category."/>
                            </Border>
                        </Popup>

                        <Popup x:Name="popupCategory" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource scWindowBackgroundBrush}" BorderBrush="{DynamicResource scBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" MaxWidth="320">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource scTextPrimaryBrush}" FontSize="13" Text="Display this item inside a Category"/>
                            </Border>
                        </Popup>

                    </Grid>
                </Border>
            </cc:ModalWindow>
        </Grid>
    </Grid>
</Window>