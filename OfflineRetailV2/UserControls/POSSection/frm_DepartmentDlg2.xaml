<Window x:Class="OfflineRetailV2.UserControls.POSSection.frm_DepartmentDlg2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OfflineRetailV2.UserControls.POSSection"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:lm="clr-namespace:OfflineRetailV2.LayoutManager"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
        AllowsTransparency="True" WindowStyle="None" Background="Transparent" WindowStartupLocation="CenterScreen"
        Title="" Width="600" Height="360" MinHeight="360" MinWidth="600" Closing="Window_Closing" Loaded="Window_Loaded" 
        >

    <Window.Resources>
        <Style x:Key="SaveButtonStyle" TargetType="Button" >
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                 Background="{TemplateBinding Background}"
                                 SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentGreenHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentGreenPressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CancelButtonStyle1" TargetType="Button" >
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#BE0909"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CancelRedHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource CancelRedPressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <cc:ModalWindow x:Name="ModalWindow">
        <Border Background="{DynamicResource ModalContentBackground}" CornerRadius="25" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" CornerRadius="12,12,0,0" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Edit Department" x:Name="Title" VerticalAlignment="Center"
                                   FontFamily="{StaticResource PoppinsBold}"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   Margin="0"/>

                        <Grid Grid.Column="1" HorizontalAlignment="Right" Margin="0" Visibility="Collapsed">
                        </Grid>
                    </Grid>
                </Border>

                <Rectangle Grid.Row="1" Style="{StaticResource DefaultLineStyle}" VerticalAlignment="Center" Margin="0,8,0,8"/>

                <Grid Grid.Row="2" Margin="10,0,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Department ID" Visibility="Collapsed" Style="{StaticResource TextBlockBaseStyle}" />
                    <dxe:TextEdit Grid.Row="2" x:Name="txtID" MaxLength="20" EditValueChanged="TxtID_EditValueChanged" Visibility="Collapsed" GotFocus="Full_GotFocus" LostFocus="Full_LostFocus"/>

                    <TextBlock Grid.Row="4" Text="Department Name" Style="{StaticResource TextBlockBaseStyle}"/>
                    <dxe:TextEdit Grid.Row="6" x:Name="txtDescription" MaxLength="30" EditValueChanged="TxtID_EditValueChanged" GotFocus="Full_GotFocus" LostFocus="Full_LostFocus"/>

                    <TextBlock Grid.Row="8" Text="Tax" Style="{StaticResource TextBlockBaseStyle}"/>
                    <dxe:ComboBoxEdit Grid.Row="10" x:Name="cmbVAT" IsTextEditable="False" NullText="[Select Tax]" EditValueChanged="TxtID_EditValueChanged"/>

                    <dxe:CheckEdit Grid.Row="12" x:Name="chkDepartmentSale" 
                                   Content="Department Sale" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Left" 
                                   FontSize="12" 
                                   Margin="5,0" 
                                   Width="120"
                                   IsChecked="True"
                                   Height="30">
                        <dxe:CheckEdit.Style>
                            <Style TargetType="dxe:CheckEdit">
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Width" Value="150"/>
                            </Style>
                        </dxe:CheckEdit.Style>
                    </dxe:CheckEdit>

                    <Grid Grid.Row="13" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="21"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="9"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="21"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content=" Scale ?" x:Name="chkScale" Click="TxtID_EditValueChanged" Visibility="Collapsed"/>
                        <TextBlock x:Name="lbDisplayOrder" Grid.Column="2" Text="Scale Display Order" Visibility="Collapsed"/>
                        <dxe:TextEdit Grid.Column="4" Width="50" Text="0" x:Name="txtDisplayOrder" Visibility="Collapsed" />
                        <CheckBox Grid.Column="6" Content=" Add to Scale Screen" x:Name="chkAddToScale" Visibility="Collapsed"/>
                    </Grid>

                    <Grid Grid.Row="14" Margin="0,9,0,0" x:Name="pGL">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sales G/L Account" Style="{StaticResource TextBlockBaseStyle}"/>
                        <dxe:ComboBoxEdit Grid.Row="2" Grid.Column="2" x:Name="cmbGL1" IsTextEditable="False" ItemsSource="{Binding}" NullText="[Select G/L Account]" EditValueChanged="TxtID_EditValueChanged" PreviewMouseLeftButtonDown="CmbGL1_PreviewMouseLeftButtonDown" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Cost G/L Account" Style="{StaticResource TextBlockBaseStyle}"/>
                        <dxe:ComboBoxEdit Grid.Row="6" Grid.Column="2" x:Name="cmbGL2" IsTextEditable="False" ItemsSource="{Binding}" NullText="[Select G/L Account]" EditValueChanged="TxtID_EditValueChanged" PreviewMouseLeftButtonDown="CmbGL1_PreviewMouseLeftButtonDown"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Payable G/L Account" Style="{StaticResource TextBlockBaseStyle}"/>
                        <dxe:ComboBoxEdit Grid.Row="10" Grid.Column="2" x:Name="cmbGL3" IsTextEditable="False" ItemsSource="{Binding}" NullText="[Select G/L Account]" EditValueChanged="TxtID_EditValueChanged" PreviewMouseLeftButtonDown="CmbGL1_PreviewMouseLeftButtonDown"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Inventory G/L Account" Style="{StaticResource TextBlockBaseStyle}"/>
                        <dxe:ComboBoxEdit Grid.Row="14" Grid.Column="2" x:Name="cmbGL4" IsTextEditable="False" ItemsSource="{Binding}" NullText="[Select G/L Account]" EditValueChanged="TxtID_EditValueChanged" PreviewMouseLeftButtonDown="CmbGL1_PreviewMouseLeftButtonDown"/>

                    </Grid>
                </Grid>

                <Grid Grid.Row="3" Margin="0,10,0,10" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnLogin"
                            Content="SAVE"
                            Style="{StaticResource SaveButtonStyle}"
                            Grid.Column="0"
                            FontFamily="{StaticResource PoppinsRegular}"
                            Click="Button_Click_1"/>

                    <Button x:Name="btnCancel"
                            Content="CANCEL"
                            Style="{StaticResource CancelButtonStyle1}"
                            Grid.Column="1"
                            Width="120"
                            Margin="5,5,0,5" HorizontalAlignment="Right"
                            FontFamily="{StaticResource PoppinsRegular}"
                            Click="Button_Click"/>
                </Grid>
            </Grid>
        </Border>
    </cc:ModalWindow>
</Window>