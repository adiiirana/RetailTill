<Window x:Class="OfflineRetailV2.UserControls.POSSection.frm_WeightedProductsDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        WindowStartupLocation="CenterScreen" Margin="50"
        Title="" Foreground="White"
        Width="1024" Height="740"
        Loaded="Window_Loaded"
        ContentRendered="Window_ContentRendered"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <cc:ModalWindow x:Name="ModalWindow" Margin="0,25,0,0">
        <Grid Margin="9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Viewbox x:Name="vbTitleIcon" Width="34" Height="34" Margin="10,0,10,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="pathTitleIcon1" Stroke="#1B3A4B" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M3.5,4.5 H20.5"/>
                            <Path x:Name="pathTitleIcon2" Stroke="#1B3A4B" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M8,4.5 V8 M16,4.5 V8"/>
                            <Path x:Name="pathTitleIcon3" Stroke="#1B3A4B" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Data="M7,8 H17 L20.5,20.5 H3.5 Z"/>
                            <Path x:Name="pathTitleIcon4" Stroke="#1B3A4B" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Data="M12,12.2 L14.3,14.8 L12,17.4 L9.7,14.8 Z"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Weighted Products" x:Name="Title" VerticalAlignment="Center"
                                   Style="{DynamicResource BlueHeading}" Margin="0"/>
                        <TextBlock Text="Place item on scale and touch a product" Margin="0,2,0,0"
                                   FontFamily="{StaticResource OSRegular}" FontSize="12"
                                   Foreground="{DynamicResource scTextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" MinWidth="180" Height="52" CornerRadius="6"
                        Background="{DynamicResource scPriceInput}" BorderBrush="{DynamicResource scBorderBrush}" BorderThickness="1" Padding="12,4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="WEIGHT ON SCALE" FontSize="10" FontFamily="{StaticResource OSSemiBold}"
                                   Foreground="{DynamicResource scTextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="tbLiveWeight" Text="0.000 KG" FontSize="22" FontWeight="Bold"
                                   FontFamily="{StaticResource OSBold}" Foreground="#4F9DAD" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="1" Height="36" Fill="{DynamicResource DividerColor}" Margin="16,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ellScaleStatus" Width="10" Height="10" Fill="#E53935" Margin="0,0,8,0"/>
                                <TextBlock x:Name="tbScaleStatus" Text="Not Connected" FontSize="13" FontWeight="SemiBold"
                                           FontFamily="{StaticResource OSSemiBold}" Foreground="#E53935"/>
                            </StackPanel>
                            <TextBlock x:Name="tbScaleReady" Text="" FontSize="12" FontFamily="{StaticResource OSRegular}"
                                       Foreground="#E53935" Margin="18,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Content="CANCEL" Height="35" Width="120" Margin="0,0,20,0"
                            FontFamily="{StaticResource OSSemiBold}" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Style="{DynamicResource CancelButtonStyle}" x:Name="btnClose" Click="BtnClose_Click"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,10,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="svCategoryTabs"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center" Padding="0"
                                  PanningMode="None"
                                  ScrollChanged="SvCategoryTabs_ScrollChanged"
                                  SizeChanged="SvCategoryTabs_SizeChanged">
                        <StackPanel x:Name="pnlCategoryTabs" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ScrollViewer>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnTabLeft" Width="36" Height="36" Cursor="Hand"
                                Click="BtnTabLeft_Click" ToolTip="Previous">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="bd" Background="#4F9DAD" CornerRadius="4">
                                        <Path Data="M14.5,7 L9,12 L14.5,17" Stroke="White" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Stretch="Uniform" Width="12" Height="14"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3E8A9A"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="btnTabRight" Width="36" Height="36" Margin="4,0,0,0" Cursor="Hand"
                                Click="BtnTabRight_Click" ToolTip="Next">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="bd" Background="#4F9DAD" CornerRadius="4">
                                        <Path Data="M9.5,7 L15,12 L9.5,17" Stroke="White" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Stretch="Uniform" Width="12" Height="14"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3E8A9A"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <cc:CustomTextBox Grid.Column="4" x:Name="txtSearch"
                                      Width="210" Height="36" VerticalAlignment="Center"
                                      BorderThickness="1" CornerRadius="18" IconOnRight="True"
                                      MaxLength="50" InfoText="Search Items"
                                      Icon="{DynamicResource Search}"
                                      FontSize="13" FontFamily="{StaticResource OSRegular}"
                                      Padding="12,0,8,0"
                                      TextChanged="TxtSearch_TextChanged"/>
                </Grid>

                <Grid Grid.Row="1" x:Name="grdProductArea" Margin="5,0,5,8">
                    <Grid x:Name="grdCardsHost" Background="#EFF4F4" ClipToBounds="True">
                        <ScrollViewer x:Name="svProducts" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent" ClipToBounds="True"
                                      PanningMode="Both" PanningRatio="1" PanningDeceleration="2"
                                      SizeChanged="SvProducts_SizeChanged">
                            <UniformGrid x:Name="pnlProducts" Columns="6" Opacity="0"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        </ScrollViewer>
                        <TextBlock x:Name="tbEmpty" Text="No weighted products found"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource OSRegular}" FontSize="16"
                                   Foreground="{DynamicResource scTextSecondaryBrush}"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </cc:ModalWindow>
</Window>
