<Window x:Class="OfflineRetailV2.UserControls.POSSection.frm_POSAddNewDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Title="POS Add New"
        Loaded="Window_Loaded"
        Width="720" Height="320">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="AccentGreen" Color="#28B463"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2DAAE1"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#E67E22"/>
        <SolidColorBrush x:Key="HeaderTextColor" Color="#232B38"/>

        <!-- Header -->
        <Style x:Key="DialogHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
         
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Base Button Style -->
        <Style x:Key="BaseOrderButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"
                                Padding="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <!-- Explicitly force text to white -->
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontSize" Value="22"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green, Blue, Orange Variants -->
        <Style x:Key="GreenOrderButton" BasedOn="{StaticResource BaseOrderButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
        </Style>

        <Style x:Key="BlueOrderButton" BasedOn="{StaticResource BaseOrderButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
        </Style>

        <Style x:Key="OrangeOrderButton" BasedOn="{StaticResource BaseOrderButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentOrange}"/>
        </Style>
    </Window.Resources>

    <cc:ModalWindow x:Name="ModalWindow">
        <Border Background="{DynamicResource ModalContentBackground}"
                CornerRadius="18"
                Padding="25"
                SnapsToDevicePixels="True"
                BorderBrush="#DADADA"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="Choose What to Add"
                           FontSize="32"
                           FontFamily="{StaticResource PoppinsExtraBold}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,25"/>

                <!-- Buttons Row -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Button Content="Item"
                            Style="{StaticResource GreenOrderButton}"
                            FontFamily="{StaticResource PoppinsBold}"
                            x:Name="btnAddItems"
                            Click="Button_Click_1"/>

                    <Button Content="Category"
                            Style="{StaticResource BlueOrderButton}"
                            FontFamily="{StaticResource PoppinsBold}"
                            x:Name="btnAddCategories"
                            Click="Button_Click_Action"/>

                    <Button Content="Misc"
                            Style="{StaticResource OrangeOrderButton}"
                            FontFamily="{StaticResource PoppinsBold}"
                            x:Name="btnMiscItems"
                            Click="Button_Click_Save"/>
                </StackPanel>
            </Grid>
        </Border>
    </cc:ModalWindow>
</Window>
