<Window x:Class="OfflineRetailV2.UserControls.POSSection.EditableInvoice_Dlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Invoice Editor" Width="1000" Background="White" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">

            <Grid Margin="0,0,0,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="150" Height="150" HorizontalAlignment="Left" BorderBrush="#E5E7EB" 
                        BorderThickness="1" Background="#F9FAFB" CornerRadius="4">
                    <Grid>
                        <StackPanel x:Name="pnlLogoPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="+" FontSize="24" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Add Your Logo" Foreground="#9CA3AF"/>
                        </StackPanel>
                        <Image x:Name="imgLogo" Stretch="Uniform" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-90,77,0">
                    <TextBlock Text="INVOICE" FontSize="48" FontWeight="Light" HorizontalAlignment="Right" Foreground="#374151"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,-25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Margin="0,0,20,15">
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Company Name" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBox x:Name="txtCompany" Style="{StaticResource ModernTextBox}" Width="372" HorizontalAlignment="Left" FontSize="12"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Phone" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#374151"/>
                                <TextBox x:Name="txtPhone" Style="{StaticResource ModernTextBox}" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Email" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#374151"/>
                                <TextBox x:Name="txtEmail" Style="{StaticResource ModernTextBox}" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Width="260">
                    <Grid Margin="0,-150,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Invoice #:"/>
                        <TextBlock Grid.Column="1" x:Name="txtReceiptNo" Text="Loading..." FontSize="15"/>
                    </Grid>

                    <Grid Margin="0,-90,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Invoice Date:"/>
                        <TextBlock Grid.Column="1" x:Name="txtInvoiceDate" Text="Loading..." FontSize="15"/>
                    </Grid>

                    <Grid Margin="0,-30,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HeaderLabel}" Text="PO Number:"/>
                        <TextBlock Grid.Column="1" x:Name="txtPONumber" Text="Loading..." FontSize="15"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Due Date:"/>
                        <TextBlock Grid.Column="1" x:Name="txtDueDate" Text="Loading..." FontSize="15"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Payment Terms"/>
                        <ComboBox Grid.Column="1" x:Name="cmbPaymentTerms" Width="140" Height="40" Background="White" 
                                  BorderBrush="#D1D5DB" BorderThickness="1" SelectionChanged="CmbPaymentTerms_SelectionChanged">
                            <ComboBoxItem Content="7 Days Payment" Tag="7"/>
                            <ComboBoxItem Content="14 Days Payment" Tag="14"/>
                            <ComboBoxItem Content="30 Days Payment" Tag="30"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Status:"/>
                        <TextBlock Grid.Column="1" x:Name="txtInvoiceStatus" Text="UNPAID" FontSize="16" FontWeight="Bold" Foreground="#C63E3B" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Margin="0,0,0,0" HorizontalAlignment="Right">
                        <Button x:Name="btnEmail" Width="100" Height="35" Margin="0,0,0,10" Background="#C63E3B" Foreground="White" BorderBrush="#C63E3B" 
                                BorderThickness="1" Cursor="Hand" Click="BtnEmail_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" Width="80" HorizontalAlignment="Center">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                    <Path Fill="White" Data="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z m0 2v.511l8 4.223 8-4.223V6H4z m0 2.578V18h16V8.578l-8 4.222-8-4.222z"/>
                                </Viewbox>
                                <TextBlock Text="EMAIL" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <Button Width="100" Height="35" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" 
                                BorderThickness="1" Cursor="Hand" Click="BtnPrint_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" Width="80" HorizontalAlignment="Center">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                    <Path Fill="White" Data="M6 9V3h12v6H6zm12 2h2a2 2 0 012 2v5h-4v3H6v-3H2v-5a2 2 0 012-2h2v2H4v3h16v-3h-2v-2zM8 19h8v2H8v-2z"/>
                                </Viewbox>
                                <TextBlock Text="PRINT" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnUpdate" Width="100" Height="35" Margin="0,10,0,0" Background="#47a929" Foreground="White" 
                                BorderBrush="#47a929" BorderThickness="1" Cursor="Hand" Click="btnUpdate_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" Width="80" HorizontalAlignment="Center">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                    <Path Fill="White" Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 000-1.41l-2.34-2.34a1 1 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                </Viewbox>
                                <TextBlock Text="UPDATE" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Margin="0,-10,0,30" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Stretch">
                    <TextBlock Text="Bill To" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#374151"/>
                    <TextBox x:Name="txtBillTo" Style="{StaticResource ModernTextBox}" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" MinHeight="80" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                    <TextBlock Text="Ship To" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#374151"/>
                    <TextBox x:Name="txtShipTo" Style="{StaticResource ModernTextBox}" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" MinHeight="80" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
            
            <Border Background="#111827" CornerRadius="4,4,0,0">
                <Grid Height="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Item" Foreground="White" VerticalAlignment="Center" Margin="15,0"/>
                    <TextBlock Grid.Column="1" Text="Quantity" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Rate" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Amount" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                </Grid>
            </Border>

            <ItemsControl x:Name="lstItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1,0,1,1">
                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox BorderThickness="0,0,1,0" BorderBrush="#E5E7EB" VerticalContentAlignment="Center" Padding="10,0" 
                                         Text="{Binding Description}" Foreground="#374151" IsReadOnly="True"/>

                                <TextBox Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="#E5E7EB" 
                                         VerticalContentAlignment="Center" TextAlignment="Center" 
                                         Text="{Binding Qty}" IsReadOnly="True"/>

                                <TextBox Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="#E5E7EB" 
                                         VerticalContentAlignment="Center" TextAlignment="Center" 
                                         Text="{Binding FormattedPrice}" IsReadOnly="True"/>

                                <TextBlock Grid.Column="3" Text="{Binding FormattedTotal}" VerticalAlignment="Center" 
                                           HorizontalAlignment="Right" Margin="0,0,15,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel x:Name="pnlNotes" Visibility="Visible">
                        <TextBlock Text="Notes" Foreground="#6B7280" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNotes" Style="{StaticResource ModernTextBox}" Height="70" Width="400" FontSize="12"
                     VerticalContentAlignment="Top" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,40,15" />
                    </StackPanel>

                    <StackPanel x:Name="pnlTerms" Visibility="Visible">
                        <TextBlock Text="Terms &amp; Conditions" Foreground="#6B7280" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtTerms" Style="{StaticResource ModernTextBox}" Height="70" Width="400" FontSize="12"
                     VerticalContentAlignment="Top" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,40,15" />
                    </StackPanel>

                    <StackPanel x:Name="pnlBankDetails" Visibility="Visible" Margin="0,10,0,0">
                        <TextBlock Text="Bank Payment Details" Foreground="#6B7280" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12" Width="400" HorizontalAlignment="Left" Background="#F9FAFB">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Bank Name:" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" Margin="0,5"/>
                                <TextBox x:Name="txtBankName" Grid.Column="1" Style="{StaticResource ModernTextBox}" FontSize="12" Margin="5,3"/>

                                <TextBlock Text="Account No:" Grid.Row="1" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" Margin="0,5"/>
                                <TextBox x:Name="txtAccountNo" Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBox}" FontSize="12" Margin="5,3"/>

                                <TextBlock Text="Sort Code:" Grid.Row="2" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" Margin="0,5"/>
                                <TextBox x:Name="txtSortCode" Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBox}" FontSize="12" Margin="5,3"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Subtotal" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#4B5563"/>
                        <TextBlock x:Name="txtSubtotal" Text="$0.00" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Tax" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#4B5563"/>
                        <TextBlock x:Name="txtTaxAmount" Text="$0.00" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,10,0,10">
                        <TextBlock Text="Total" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTotal" Text="$0.00" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Amount Paid" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtAmountPaid" Text="$0.00" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="Balance Due" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtBalanceDue" Text="$0.00" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#C63E3B"/>
                    </Grid>

                    <StackPanel Margin="0,30,0,0" HorizontalAlignment="Right">
                        <Border Width="150" Height="80" HorizontalAlignment="Right" BorderBrush="#E5E7EB" 
                    BorderThickness="1" Background="#F9FAFB" CornerRadius="4">
                            <Grid>
                                <StackPanel x:Name="pnlSignaturePlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="No Signature" FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Image x:Name="imgSignature" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <TextBlock Text="Authorized Signature" FontSize="11" Foreground="#6B7280" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>