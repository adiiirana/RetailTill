<Window x:Class="OfflineRetailV2.UserControls.POSSection.frmPOSItemDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OfflineRetailV2.UserControls.POSSection"
            xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:lm="clr-namespace:OfflineRetailV2.LayoutManager"
           xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
         xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
         xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
        xmlns:pcc="clr-namespace:POSControls"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent" WindowStartupLocation="CenterScreen"
        Title="" Foreground="White"   
        Width="800" Height="600" Loaded="Window_Loaded"
        FocusVisualStyle="{x:Null}">

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="scTextEditStyle" TargetType="dxe:TextEdit">
                <Setter Property="Height" Value="34"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource scBorderBrush}"/>
                <Setter Property="Background" Value="{DynamicResource scControlBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource scTextPrimaryBrush}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10,0,10,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="scComboBoxEditStyle" TargetType="dxe:ComboBoxEdit">
                <Setter Property="Height" Value="34"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource scBorderBrush}"/>
                <Setter Property="Background" Value="{DynamicResource scControlBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource scTextPrimaryBrush}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10,0,10,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="scPrimaryButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{DynamicResource scPrimaryGreenBrush}"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="6" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource scPrimaryGreenHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource scPrimaryGreenPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="scSecondaryButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource scTextPrimaryBrush}"/>
                <Setter Property="Background" Value="{DynamicResource scSecondaryButtonBrush}"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="6" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="scKeypadButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource scKeypadBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource scBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource scTextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource scKeypadHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource scBorderBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="scInlineQtyBoxStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource scBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="{DynamicResource scControlBackgroundBrush}"/>
                <Setter Property="Height" Value="34"/>
            </Style>

            <Style x:Key="scInlineQtyButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="scHeroInputBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource scControlBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource scBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="scWeightUomChipStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,3,6,3"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource scKeypadHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="scWeightUomOptionStyle" TargetType="Button">
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource scTextSecondaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource scKeypadHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource scPriceInput}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="scFieldInputBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource scControlBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource scBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border x:Name="dimOverlay" Background="#44000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>

        <Grid x:Name="dialogHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <cc:ModalWindow  x:Name="ModalWindow">
                <Grid>
                    <Grid x:Name="gridClassic" Margin="9" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Edit Product"  x:Name="Title" VerticalAlignment="Center" Style="{DynamicResource BlueHeading}" />
                            <Grid Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="9"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="9"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="9"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="9"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>


                                <Button Grid.Column="0" Grid.Row="2" Content="KEYBOARD" Style="{DynamicResource GeneralButtonStyle}" Width="120" Height="35"
                                    x:Name="btnKeyboard" Click="btnKeyboard_Click" Visibility="Collapsed"/>
                                <Button Grid.Column="2" Grid.Row="0" Content="Help" Style="{DynamicResource GeneralButtonStyle}" Width="120" Height="35"
                                    x:Name="btnHelp" Click="btnHelp_Click" Visibility="Collapsed"/>
                                <Button Grid.Column="4" Grid.Row="0" Content="Weight" Visibility="Collapsed" Style="{DynamicResource GeneralButtonStyle}" Width="120" Height="35"
                                    x:Name="btnWeight" Click="btnWeight_Click"/>
                                <Button Grid.Column="8" Grid.Row="2" Content="DONE" Style="{DynamicResource SaveButtonStyle}" FontFamily="{StaticResource OSSemiBold}" Width="120" Height="35"
                                    x:Name="btnOK" Click="btnOK_Click"/>
                                <Button Grid.Column="6" Grid.Row="2" Content="CANCEL" Style="{DynamicResource CancelButtonStyle}" FontFamily="{StaticResource OSSemiBold}" Width="120" Height="35"
                                    x:Name="btnCancel" Click="btnCancel_Click"/>
                            </Grid>
                        </Grid>
                        <Rectangle Grid.Row="1" Style="{DynamicResource DefaultLineStyle}"  VerticalAlignment="Center"  Margin="-9,0"/>

                        <Grid Margin="9" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="2"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="7,0,7,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="9"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{DynamicResource GreenBorder}">
                                    <TextBlock Style="{DynamicResource GreenBorderInfo}" Text="Modify Item Details"></TextBlock>
                                </Border>

                                <TabControl  x:Name="tbctrl" Style="{DynamicResource NoTab}" Grid.Row="2">
                                    <TabControl.ItemContainerStyle>
                                        <Style TargetType="{x:Type TabItem}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </TabControl.ItemContainerStyle>
                                    <TabItem x:Name="tpSales" Header="Sale" >
                                        <Grid >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Product"/>
                                            <dxe:TextEdit Grid.Row="2" Grid.Column="2"  x:Name="txtProduct" GotFocus="Full_GotFocus" LostFocus="Full_LostFocus"/>
                                            <TextBlock Grid.Row="4" Text="Quantity" x:Name="lblQty"/>
                                            <Grid Grid.Row="6" Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="9"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <dxe:TextEdit Grid.Column="0" Mask="f2" MaskType="Numeric" MaskUseAsDisplayFormat="True" Text="0.00"  x:Name="txtQty" SelectAllOnGotFocus="True" GotFocus="Num_GotFocus" LostFocus="Num_LostFocus"/>
                                                <TextBlock x:Name="lbUOM" Grid.Column="2" Text="UOM" Visibility="Hidden" ></TextBlock>
                                            </Grid>

                                            <TextBlock Grid.Row="8" Text="Price" x:Name="lbPrice"/>
                                            <dxe:TextEdit Grid.Row="10" Grid.Column="0" Mask="f2" MaskType="Numeric" MaskUseAsDisplayFormat="True"  Text="0.00"  x:Name="numPrice" SelectAllOnGotFocus="True" GotFocus="Num_GotFocus" LostFocus="Num_LostFocus"/>

                                            <TextBlock Grid.Row="12" Grid.Column="2" Text="Current Price" x:Name="lblabel"/>

                                            <Grid Grid.Row="14" Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>


                                                <dxe:TextEdit Grid.Row="2" Grid.Column="0"  Mask="f2" MaskType="Numeric" MaskUseAsDisplayFormat="True" Text="0.00"   x:Name="numCost" SelectAllOnGotFocus="True" GotFocus="Num_GotFocus" LostFocus="Num_LostFocus"/>
                                                <dxe:TextEdit Grid.Row="2" Grid.Column="4"  Mask="f2" MaskType="Numeric" MaskUseAsDisplayFormat="True" Text="0.00"   x:Name="numCurrPrice" SelectAllOnGotFocus="True" GotFocus="Num_GotFocus" LostFocus="Num_LostFocus"/>
                                            </Grid>
                                            <TextBlock Grid.Row="16" Text="Discount $" x:Name="lbDiscount1"/>
                                            <dxe:TextEdit Grid.Row="18" Grid.Column="2"  Mask="f2" MaskType="Numeric" MaskUseAsDisplayFormat="True" Text="0.00"   x:Name="numDiscount" SelectAllOnGotFocus="True" GotFocus="Num_GotFocus" LostFocus="Num_LostFocus"/>
                                        </Grid>
                                    </TabItem>
                                    <TabItem x:Name="tpRent" Header="Rent"  >
                                        <Grid >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Product" />
                                            <dxe:TextEdit Grid.Row="2" Grid.Column="2" x:Name="txtRentProduct" GotFocus="Full_GotFocus" LostFocus="Full_LostFocus"/>

                                            <Grid Grid.Row="4" x:Name="pnlrent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="9"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="9"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"></RowDefinition>
                                                    <RowDefinition Height="9"></RowDefinition>
                                                    <RowDefinition Height="Auto"></RowDefinition>
                                                </Grid.RowDefinitions>
                                                <Button Grid.Column="0" Style="{DynamicResource GeneralButtonStyle}" x:Name="rb1"
                                            Click="rb1_Click" Height="35" Content="Minute Basis" Tag="MI">

                                                </Button>
                                                <Button Grid.Column="2" Style="{DynamicResource GeneralButtonStyle}" x:Name="rb2" Tag="HR"
                                            Click="rb1_Click" Height="35" Content="Hourly">

                                                </Button>
                                                <Button Grid.Column="4" Style="{DynamicResource GeneralButtonStyle}" x:Name="simpleButton1"
                                            Click="rb1_Click" Tag="HD" Height="35" Content="Half Day">

                                                </Button>
                                                <Button Grid.Column="0" Grid.Row="2" Style="{DynamicResource GeneralButtonStyle}" x:Name="rb3" Tag="DY"
                                            Click="rb1_Click" Height="35" Content="Daily">

                                                </Button>
                                                <Button Grid.Column="2" Grid.Row="2" Style="{DynamicResource GeneralButtonStyle}" x:Name="rb4" Tag="WK"
                                            Click="rb1_Click" Height="35" Content="Weekly">

                                                </Button>
                                                <Button Grid.Column="4" Grid.Row="2" Style="{DynamicResource GeneralButtonStyle}" x:Name="rb5" Tag="MN"
                                            Click="rb1_Click" Height="35" Content="Monthly">

                                                </Button>
                                            </Grid>


                                            <TextBlock Grid.Row="6" Text="Duration"/>

                                            <Grid Grid.Row="8" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="9"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="9"/>
                                                </Grid.ColumnDefinitions>

                                                <dxe:TextEdit Grid.Row="6" Grid.Column="0"  Text="0.00" 
                                         x:Name="txtRentDuration" Mask="f2" MaskType="Numeric" MaskUseAsDisplayFormat="True" EditValueChanged="TxtRentPrice_EditValueChanged" SelectAllOnGotFocus="True" GotFocus="Num_GotFocus" LostFocus="Num_LostFocus"/>

                                                <TextBlock Grid.Row="8" Grid.Column="2" Text="Qty" x:Name="lbrenttype"/>

                                            </Grid>


                                            <TextBlock Grid.Row="10" Text="Rent"/>

                                            <dxe:TextEdit Grid.Row="12" Grid.Column="0" Mask="f2" MaskType="Numeric" MaskUseAsDisplayFormat="True" Text="0.00"  x:Name="txtRentPrice" EditValueChanged="TxtRentPrice_EditValueChanged" SelectAllOnGotFocus="True" GotFocus="Num_GotFocus" LostFocus="Num_LostFocus"/>


                                            <TextBlock Grid.Row="14" Grid.Column="6" Text="Qty"/>
                                            <dxe:TextEdit Grid.Row="16" Grid.Column="8" Mask="f2" MaskType="Numeric" MaskUseAsDisplayFormat="True" Text="0.00"  x:Name="txtRentQty" EditValueChanged="TxtRentPrice_EditValueChanged" SelectAllOnGotFocus="True" GotFocus="Num_GotFocus" LostFocus="Num_LostFocus"/>



                                            <TextBlock Grid.Row="18" Grid.Column="2" Text="Total Rent"/>
                                            <dxe:TextEdit Grid.Row="20" Grid.Column="4" Mask="f2" MaskType="Numeric" MaskUseAsDisplayFormat="True" Text="0.00"  x:Name="numTotal" IsReadOnly="True" IsTabStop="False"/>


                                            <Grid Grid.Row="2" Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="21"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="21"/>
                                                    <ColumnDefinition Width="4*"/>
                                                </Grid.ColumnDefinitions>



                                            </Grid>

                                            <Grid Grid.Row="4" Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="21"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="21"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="21"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="21"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                            </Grid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem x:Name="tpRepair" Header="Repair" >
                                        <Grid >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Product"/>
                                            <dxe:TextEdit Grid.Row="2" Grid.Column="2" x:Name="txtRepairProduct" GotFocus="Full_GotFocus" LostFocus="Full_LostFocus"/>
                                            <TextBlock Grid.Row="4" Text="SL No."/>

                                            <dxe:TextEdit Grid.Row="6" Grid.Column="0" x:Name="txtRepairSL" GotFocus="Full_GotFocus" LostFocus="Full_LostFocus"/>
                                            <TextBlock Grid.Row="8" Grid.Column="2" Text="Tag"/>
                                            <TextBlock Grid.Row="10" Grid.Column="4" x:Name="txtRepairTag" />


                                            <TextBlock Grid.Row="12" Text="Purchase On"/>
                                            <dxe:DateEdit Grid.Row="14" Grid.Column="0" x:Name="dtRepairPurchase" PreviewMouseLeftButtonDown="DtRepairPurchase_PreviewMouseLeftButtonDown"/>
                                            <TextBlock Grid.Row="16" Grid.Column="2" Text="Charges"/>
                                            <dxe:TextEdit Grid.Row="18" Grid.Column="4"  Text="0.00"  x:Name="txtRepairAmt" Mask="f2" MaskType="Numeric" MaskUseAsDisplayFormat="True" SelectAllOnGotFocus="True" GotFocus="Num_GotFocus" LostFocus="Num_LostFocus"/>
                                        </Grid>
                                    </TabItem>
                                </TabControl>

                            </Grid>

                            <Grid Grid.Column="2" Margin="7,0,7,0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="9"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{DynamicResource OrangeBorder}">
                                    <TextBlock Style="{DynamicResource OrangeBorderInfo}" Text="Modify Tax"></TextBlock>
                                </Border>

                                <dxg:GridControl Grid.Row="2" ShowBorder="True" x:Name="grdTax">
                                    <dxg:GridControl.View>
                                        <dxg:TableView x:Name="gridView1" NavigationStyle="Cell"/>
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="ID" Header="Tax ID" Width="*" x:Name="colID" Visible="False"/>
                                    <dxg:GridColumn FieldName="Image" Visible="False" VisibleIndex="-1" Width="*" AllowAutoFilter="False" Focusable="False">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ImageEditSettings Stretch="UniformToFill"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="TaxName" Header="Tax" Width="*" x:Name="colTaxName" AllowEditing="False" AllowFocus="False"/>
                                    <dxg:GridColumn FieldName="CheckTax" Header="Applicable ?" Width="0.5*" x:Name="colCheckTax" AllowEditing="True" AllowFocus="True" HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:CheckEditSettings x:Name="repCheck"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="TaxRate" Header="Tax Rate" Width="*" x:Name="colRate" Visible="False"/>
                                </dxg:GridControl>

                            </Grid>

                        </Grid>
                    </Grid>

                    <Border x:Name="gridModern" Visibility="Collapsed"
                            Background="{DynamicResource scWindowBackgroundBrush}"
                            CornerRadius="15" Padding="14,12" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Center">
                                <TextBlock x:Name="txtModernTitle" Text="Weight Product" Foreground="{DynamicResource scTextSecondaryBrush}" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource PoppinsBold}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtModernSubtitle" Text="Enter details for weight" Foreground="{DynamicResource scTextSecondaryBrush}" FontSize="12" Margin="0,1,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel x:Name="pnlModernFields" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Stretch">

                                <StackPanel x:Name="pnlProductField" Margin="0,0,0,8">
                                    <TextBlock Text="Product" Margin="0,0,0,2" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                    <dxe:TextEdit x:Name="txtModernProduct"
                                          Style="{StaticResource scTextEditStyle}"
                                          HorizontalAlignment="Stretch"
                                          FontSize="15"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource scTextSecondaryBrush}"
                                          Height="34"
                                          NullText="Enter item name..."
                                          NullTextForeground="#808080"
                                          ShowNullTextIfFocused="True"
                                          GotFocus="Full_GotFocus"
                                          LostFocus="Full_LostFocus"/>
                                </StackPanel>

                                <StackPanel x:Name="pnlWeightField" Margin="0,0,0,8">
                                    <TextBlock Text="Weight" Margin="0,0,0,2" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                    <Border x:Name="bdWeightHero" Style="{StaticResource scHeroInputBorderStyle}"
                                            MouseLeftButtonDown="bdWeightHero_MouseLeftButtonDown">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Viewbox Width="22" Height="22" Margin="0,0,10,0">
                                                    <Path Fill="{DynamicResource scTextSecondaryBrush}"
                                                          Data="M12,3A4,4 0 0,1 16,7H8A4,4 0 0,1 12,3M4,9H20A1,1 0 0,1 21,10V11A1,1 0 0,1 20,12H19.5L18,21H6L4.5,12H4A1,1 0 0,1 3,11V10A1,1 0 0,1 4,9M12,5A2,2 0 0,0 10,7H14A2,2 0 0,0 12,5Z"/>
                                                </Viewbox>
                                                <TextBlock x:Name="txtWeightDisplay" Text="0.000" FontSize="24" FontWeight="Bold"
                                                           Foreground="{DynamicResource scTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border x:Name="bdWeightUomChip" Style="{StaticResource scWeightUomChipStyle}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    MouseLeftButtonDown="bdWeightUomChip_MouseLeftButtonDown"
                                                    MouseLeftButtonUp="bdWeightUomChip_MouseLeftButtonUp">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="txtWeightUom" Text="Kg" FontSize="20" FontWeight="Bold"
                                                               Foreground="{DynamicResource scTextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Path x:Name="pathWeightUomCaret"
                                                          Data="M7,10L12,15L17,10H7Z" Width="12" Height="9" Stretch="Uniform"
                                                          Fill="{DynamicResource scTextSecondaryBrush}" Margin="6,3,0,0"
                                                          VerticalAlignment="Center" Opacity="0.7"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Popup x:Name="popupWeightUom"
                                           PlacementTarget="{Binding ElementName=bdWeightUomChip}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade"
                                           HorizontalOffset="-8"
                                           VerticalOffset="4">
                                        <Border Background="{DynamicResource scWindowBackgroundBrush}"
                                                BorderBrush="{DynamicResource scBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="6"
                                                MinWidth="128">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Button x:Name="btnUomLb" Content="Lb" Tag="Lb" Style="{StaticResource scWeightUomOptionStyle}" Click="WeightUomOption_Click"/>
                                                <Button x:Name="btnUomKg" Content="Kg" Tag="Kg" Style="{StaticResource scWeightUomOptionStyle}" Click="WeightUomOption_Click"/>
                                                <Button x:Name="btnUomGrams" Content="Grams" Tag="Grams" Style="{StaticResource scWeightUomOptionStyle}" Click="WeightUomOption_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>

                                <StackPanel x:Name="pnlPriceHeroField" Margin="0,0,0,8">
                                    <TextBlock Text="Price" Margin="0,0,0,2" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                    <Border x:Name="bdPriceHero" Style="{StaticResource scFieldInputBorderStyle}"
                                            MouseLeftButtonDown="bdPriceHero_MouseLeftButtonDown">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock x:Name="txtHeroCurrency" Text="£" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource scTextSecondaryBrush}" Margin="0,0,4,0"/>
                                            <TextBlock x:Name="txtHeroPriceDisplay" Text="0.00" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Grid x:Name="pnlSecondaryAmounts" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="pnlPriceField" Grid.Column="0">
                                        <TextBlock Text="Price" Margin="0,0,0,2" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                        <Border x:Name="bdWeightPrice" Style="{StaticResource scFieldInputBorderStyle}"
                                                MouseLeftButtonDown="bdWeightPrice_MouseLeftButtonDown">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock x:Name="txtWeightPriceCurrency" Text="£" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource scTextSecondaryBrush}" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="txtPriceDisplay" Text="0.00" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel x:Name="pnlCostField" Grid.Column="0">
                                        <TextBlock Text="Cost" Margin="0,0,0,2" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                        <Border x:Name="bdCost" Style="{StaticResource scFieldInputBorderStyle}"
                                                MouseLeftButtonDown="bdCost_MouseLeftButtonDown">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock x:Name="txtCostCurrency" Text="£" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource scTextSecondaryBrush}" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="txtCostDisplay" Text="0.00" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Discount" Margin="0,0,0,2" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                        <Border x:Name="bdDiscount" Style="{StaticResource scFieldInputBorderStyle}"
                                                MouseLeftButtonDown="bdDiscount_MouseLeftButtonDown">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock x:Name="txtDiscountCurrency" Text="£" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource scTextSecondaryBrush}" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="txtDiscountDisplay" Text="0.00" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="pnlQtyTaxRow" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="colQty" Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel x:Name="pnlQtyBox" Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                                        <TextBlock Text="Qty" Margin="0,0,0,2" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                        <Border Style="{StaticResource scInlineQtyBoxStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="btnQtyMinus" Grid.Column="0" Content="−" Style="{StaticResource scInlineQtyButtonStyle}" Foreground="{DynamicResource scDestructiveBrush}" Click="btnQtyMinus_Click"/>
                                                <TextBlock x:Name="txtModernQty" Grid.Column="1" Text="1" Foreground="{DynamicResource scTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                                <Button x:Name="btnQtyPlus" Grid.Column="2" Content="+" Style="{StaticResource scInlineQtyButtonStyle}" Foreground="{DynamicResource scPrimaryGreenBrush}" Click="btnQtyPlus_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                        <TextBlock Text="Tax" Margin="0,0,0,2" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                        <dxe:ComboBoxEdit x:Name="cmbModernTax"
                                                          Style="{StaticResource scComboBoxEditStyle}"
                                                          IsTextEditable="False"
                                                          Foreground="{DynamicResource scTextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <UniformGrid x:Name="pnlModernKeypad" Columns="3" Rows="4" Margin="0,0,0,6">
                                    <Button Content="7" Style="{StaticResource scKeypadButtonStyle}" Click="ModernKeypad_NumClick"/>
                                    <Button Content="8" Style="{StaticResource scKeypadButtonStyle}" Click="ModernKeypad_NumClick"/>
                                    <Button Content="9" Style="{StaticResource scKeypadButtonStyle}" Click="ModernKeypad_NumClick"/>
                                    <Button Content="4" Style="{StaticResource scKeypadButtonStyle}" Click="ModernKeypad_NumClick"/>
                                    <Button Content="5" Style="{StaticResource scKeypadButtonStyle}" Click="ModernKeypad_NumClick"/>
                                    <Button Content="6" Style="{StaticResource scKeypadButtonStyle}" Click="ModernKeypad_NumClick"/>
                                    <Button Content="1" Style="{StaticResource scKeypadButtonStyle}" Click="ModernKeypad_NumClick"/>
                                    <Button Content="2" Style="{StaticResource scKeypadButtonStyle}" Click="ModernKeypad_NumClick"/>
                                    <Button Content="3" Style="{StaticResource scKeypadButtonStyle}" Click="ModernKeypad_NumClick"/>
                                    <Button Content="Clear" Style="{StaticResource scKeypadButtonStyle}" Click="ModernKeypad_ClearClick" Foreground="{DynamicResource scDestructiveBrush}" FontSize="16"/>
                                    <Button Content="0" Style="{StaticResource scKeypadButtonStyle}" Click="ModernKeypad_NumClick"/>
                                    <Button Style="{StaticResource scKeypadButtonStyle}" Click="ModernKeypad_BackspaceClick">
                                        <Path Data="M19,15.59L17.59,17L14,13.41L10.41,17L9,15.59L12.59,12L9,8.41L10.41,7L14,10.59L17.59,7L19,8.41L15.41,12L19,15.59M22,3A2,2 0 0,1 24,5V19A2,2 0 0,1 22,21H7C6.31,21 5.77,20.64 5.41,20.11L0,12L5.41,3.88C5.77,3.35 6.31,3 7,3H22Z"
                                              Fill="{DynamicResource scTextPrimaryBrush}" Height="16" Stretch="Uniform"/>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="DONE" x:Name="btnModernOK" Style="{StaticResource scPrimaryButtonStyle}" Grid.Column="0" Foreground="White" Margin="0,0,10,0" Click="btnOK_Click"/>
                                <Button Content="CANCEL" x:Name="btnModernCancel" Style="{StaticResource scSecondaryButtonStyle}" Grid.Column="1" Width="120" Click="btnCancel_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </cc:ModalWindow>
        </Grid>
    </Grid>
</Window>
