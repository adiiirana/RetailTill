<Window x:Class="OfflineRetailV2.UserControls.POSSection.frm_TradeInvoicesListDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent" WindowStartupLocation="CenterScreen"
        Title="Trade Invoices" Foreground="White" Width="1024" Height="740">
    <cc:ModalWindow x:Name="ModalWindow">
        <Grid Margin="9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="9"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="9"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Trade Invoices" x:Name="Title" Style="{DynamicResource BlueHeading}" FontFamily="{StaticResource OSRegular}" FontSize="20" />
                <Grid Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="9"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="9"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="CANCEL" Height="35" Width="120" FontFamily="{StaticResource OSSemiBold}" 
                            Style="{DynamicResource CancelButtonStyle}" x:Name="btnCancel" Click="BtnCancel_Click"/>
                    <Button Grid.Column="2" Content="EDIT A4 INVOICE" Height="35" Width="120" FontFamily="{StaticResource OSSemiBold}" 
                            Style="{DynamicResource SaveButtonStyle}" x:Name="btnEditBusinessInfo" Click="BtnEditBusinessInfo_Click"/>
                    <Button Grid.Column="4" Content="SELECT INVOICE" Height="35" Width="120" FontFamily="{StaticResource OSSemiBold}" 
                            Style="{DynamicResource GeneralButtonStyle}" x:Name="btnSelectInvoice" Click="BtnSelectInvoice_Click"/>
                </Grid>
            </Grid>
            <Rectangle Grid.Row="1" Style="{DynamicResource DefaultLineStyle}" VerticalAlignment="Center" Margin="-9,0"/>

            <Grid Grid.Row="2" Margin="0,9,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="11"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <cc:CustomTextBox InfoText="Search Trade Invoices" Icon="{DynamicResource Search}" 
                                  x:Name="txtSearchGrdData" TextChanged="TxtSearchGrdData_TextChanged" />
                <Grid Grid.Row="2">
                    <dxg:GridControl ShowBorder="False" SelectionMode="Row" x:Name="grdTradeInvoices" CustomColumnDisplayText="GrdTradeInvoices_CustomColumnDisplayText">
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="gridViewTrade" PreviewMouseDoubleClick="gridView_PreviewMouseDoubleClick" AllowEditing="False"/>
                        </dxg:GridControl.View>

                        <dxg:GridColumn FieldName="InvoiceNo" Visible="False"/>
                        <dxg:GridColumn FieldName="TradeInvoiceId" Header="Invoice #" Width="65"/>

                        <dxg:GridColumn FieldName="InvoiceDate" Header="Date" Width="90">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="dd/MM/yyyy"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="Customer" Header="Company Name" Width="2.0*"/>


                        <dxg:GridColumn FieldName="Amount" Header="Gross Total" Width="90">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="f2" MaskType="Numeric" HorizontalContentAlignment="Right"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="AmountPaid" Header="Amount Paid" Width="90">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="f2" MaskType="Numeric" HorizontalContentAlignment="Right"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="BalanceDue" Header="Balance Due" Width="90">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="f2" MaskType="Numeric" HorizontalContentAlignment="Right"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="DueDate" Header="Due Date" Width="90">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="dd/MM/yyyy"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="Status" Header="Status" Width="92"/>

                        <dxg:GridColumn FieldName="Status" Visible="False"/>
                        <dxg:GridColumn Header="Actions" Width="200" FixedWidth="True" AllowSorting="False" AllowEditing="False">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Email Button -->
                                        <Button Grid.Column="0" Height="30" Width="48" Cursor="Hand" ToolTip="Email Invoice" 
                                                Click="BtnEmail_Click" Tag="{Binding RowData.Row.TradeInvoiceId}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RowData.Row.Status}" Value="Voided">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#0078D4" CornerRadius="6">
                                                        <Path Data="M20,4H4C2.897,4 2,4.897 2,6V18C2,19.103 2.897,20 4,20H20C21.103,20 22,19.103 22,18V6C22,4.897 21.103,4 20,4ZM20,6L12,11.5L4,6H20ZM4,18V8.381L11.447,13.447C11.61,13.56 11.805,13.618 12,13.618C12.195,13.618 12.39,13.56 12.553,13.447L20,8.381L20.002,18H4Z" 
                                                              Fill="White" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Pay Button -->
                                        <Button Grid.Column="2" Height="30" Cursor="Hand" ToolTip="Pay Invoice" 
                                                Click="BtnPay_Click" Tag="{Binding RowData.Row.TradeInvoiceId}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RowData.Row.Status}" Value="Paid">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="Opacity" Value="0.7" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RowData.Row.Status}" Value="Voided">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="Opacity" Value="0.7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#47a929" CornerRadius="6">
                                                        <TextBlock Text="Pay" Foreground="White" FontWeight="Bold" FontSize="13" FontFamily="{StaticResource OSSemiBold}" 
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Void Button -->
                                        <Button Grid.Column="4" Height="30" Cursor="Hand" ToolTip="Void Invoice" Click="BtnVoid_Click" 
                                                Tag="{Binding RowData.Row.TradeInvoiceId}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RowData.Row.Status}" Value="Voided">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="Opacity" Value="0.7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#c63e3b" CornerRadius="6">
                                                        <TextBlock Text="Void" Foreground="White" FontWeight="Bold" FontSize="13" FontFamily="{StaticResource OSSemiBold}" 
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                    </dxg:GridControl>
                </Grid>
            </Grid>
            <Grid Grid.Row="4" Margin="9" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="9"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="100" Height="35"
                        Style="{DynamicResource YellowButtonStyle}" x:Name="btnUpHeader" Click="BtnUpHeader_Click">
                    <Image Source="{DynamicResource Arrow_U}" Width="21" Height="21"/>
                </Button>
                <Button Grid.Column="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="100" Height="35"
                        Style="{DynamicResource YellowButtonStyle}" x:Name="btnDownHeader" Click="BtnDownHeader_Click">
                    <Image Source="{DynamicResource Arrow_D}" Width="21" Height="21"/>
                </Button>
            </Grid>
        </Grid>
    </cc:ModalWindow>
</Window>