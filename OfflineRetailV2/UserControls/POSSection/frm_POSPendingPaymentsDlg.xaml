<Window x:Class="OfflineRetailV2.UserControls.POSSection.frm_POSPendingPaymentsDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OfflineRetailV2.UserControls.POSSection"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent" WindowStartupLocation="CenterScreen"
        Title="Pending Payments" Foreground="White" Width="1024" Height="740">
    <cc:ModalWindow  x:Name="ModalWindow">
        <Grid Margin="9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="9"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="9"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Pending Payments" x:Name="Title" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" />
                <Grid Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="9"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="CANCEL" Height="35" Width="120" FontFamily="{StaticResource OSSemiBold}" 
                            Style="{DynamicResource CancelButtonStyle}" x:Name="btnCancel" Click="BtnCancel_Click"/>
                    <Button Grid.Column="2" Content="SELECT" Height="35" Width="120" FontFamily="{StaticResource OSSemiBold}" 
                            Style="{DynamicResource SaveButtonStyle}" x:Name="btnOK" Click="btnOK_Click"/>
                </Grid>
            </Grid>
            <Rectangle Grid.Row="1" Style="{DynamicResource DefaultLineStyle}" VerticalAlignment="Center" Margin="-9,0"/>

            <Grid Grid.Row="2" Margin="0,9,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="11"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <cc:CustomTextBox InfoText="Search Unpaid Invoices" Icon="{DynamicResource Search}" 
                                  x:Name="txtSearchGrdData" TextChanged="TxtSearchGrdData_TextChanged" />
                <Grid Grid.Row="2">
                    <dxg:GridControl ShowBorder="False" SelectionMode="Row" x:Name="grdPendingPayments">
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="gridViewPending" PreviewMouseDoubleClick="gridView_PreviewMouseDoubleClick"/>
                        </dxg:GridControl.View>
                        <dxg:GridColumn FieldName="InvoiceNo" Header="Invoice ID" Width="1*"/>
                        <dxg:GridColumn FieldName="DateTimeSuspended" Header="Date" Width="1.5*"/>
                        <dxg:GridColumn FieldName="Customer" Header="Customer" Width="2*"/>
                        <dxg:GridColumn FieldName="Amount" Header="Amount" Width="1*">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="f2" MaskType="Numeric"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="FirstItem" Header="Item" Width="2.5*"/>
                        <dxg:GridColumn FieldName="PaymentStatus" Header="Payment Status" Width="1*"/>
                    </dxg:GridControl>
                </Grid>
            </Grid>
            <Grid Grid.Row="4" Margin="9" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="9"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="100" Height="35"
                        Style="{DynamicResource YellowButtonStyle}" x:Name="btnUpHeader" Click="BtnUpHeader_Click">
                    <Image Source="{DynamicResource Arrow_U}" Width="21" Height="21"/>
                </Button>
                <Button Grid.Column="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="100" Height="35"
                        Style="{DynamicResource YellowButtonStyle}" x:Name="btnDownHeader" Click="BtnDownHeader_Click">
                    <Image Source="{DynamicResource Arrow_D}" Width="21" Height="21"/>
                </Button>
            </Grid>
        </Grid>
    </cc:ModalWindow>
</Window>