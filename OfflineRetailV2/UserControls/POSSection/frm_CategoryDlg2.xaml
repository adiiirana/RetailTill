<Window x:Class="OfflineRetailV2.UserControls.POSSection.frm_CategoryDlg2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" 
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentGreen" Color="#29BF6A"/>
        <SolidColorBrush x:Key="AccentGreenHover" Color="#24A65C"/>
        <SolidColorBrush x:Key="AccentGreenPressed" Color="#1F8F50"/>
        <SolidColorBrush x:Key="AccentGray" Color="#999999"/>
        <SolidColorBrush x:Key="AccentGrayHover" Color="#888888"/>
        <SolidColorBrush x:Key="AccentGrayPressed" Color="#777777"/>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentGreenHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdvanceButtonStyleNew" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentGray}"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentGrayHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentGrayPressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SaveButtonStyleNew" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentGreenHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentGreenPressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CancelButtonStyleNew" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#BE0909"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A80808"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#900707"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#44000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="550">
            <Border CornerRadius="25" Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.2" Color="Black"/>
                </Border.Effect>
            </Border>

            <cc:ModalWindow x:Name="ModalWindow">
                <Border Background="{DynamicResource ModalContentBackground}" CornerRadius="25" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" CornerRadius="12,12,0,0" Padding="10">
                            <TextBlock Text="Add Category" FontSize="22" FontFamily="{StaticResource PoppinsBold}" HorizontalAlignment="Center"/>
                        </Border>

                        <Rectangle Grid.Row="1" Height="1" Fill="#DDD" Margin="0,8,0,8"/>

                        <Grid Grid.Row="2" Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="208*"/>
                                <ColumnDefinition Width="211*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="1" Text="Category ID" Margin="0,0,0,26" FontSize="16" FontFamily="{StaticResource PoppinsSemiBold}" Visibility="Collapsed" Grid.ColumnSpan="2" Grid.RowSpan="3"/>
                            <dxe:TextEdit Grid.Row="2" x:Name="txtID" MaxLength="20" EditValueChanged="TxtID_EditValueChanged" Visibility="Collapsed" FontFamily="{StaticResource PoppinsRegular}" GotFocus="Num_GotFocus" LostFocus="Full_LostFocus" Grid.ColumnSpan="2" Margin="0,4,0,38" Grid.RowSpan="3"/>

                            <TextBlock Grid.Row="3" Text="Category Name" Margin="0,0,0,2" FontSize="16" FontFamily="{StaticResource PoppinsSemiBold}" Grid.ColumnSpan="2"/>
                            <dxe:TextEdit Grid.Row="4" x:Name="txtDescription" MaxLength="20" EditValueChanged="TxtID_EditValueChanged" FontFamily="{StaticResource PoppinsRegular}" GotFocus="Full_GotFocus" LostFocus="Full_LostFocus" Grid.ColumnSpan="2"/>

                            <TextBlock Grid.Row="5" Text="Parent Category" Margin="0,10,0,2" FontWeight="SemiBold" FontSize="16" FontFamily="{StaticResource PoppinsSemiBold}" Grid.ColumnSpan="2"/>
                            <dxg:LookUpEdit Grid.Row="6" x:Name="cmbParentCategory" ItemsSource="{Binding}" DisplayMember="Description" ValueMember="ID" AutoPopulateColumns="False" FontFamily="{StaticResource PoppinsRegular}" AutoComplete="True" IncrementalFiltering="True" ImmediatePopup="True" IsPopupAutoWidth="True" PopupWidth="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth}" PreviewMouseLeftButtonDown="CmbParentCategory_PreviewMouseLeftButtonDown" EditValueChanged="CmbParentCategory_EditValueChanged" Grid.ColumnSpan="2">
                                <dxg:LookUpEdit.PopupContentTemplate>
                                    <ControlTemplate>
                                        <dxg:GridControl Name="PART_GridControl" AutoGenerateColumns="None">
                                            <dxg:GridControl.Columns>
                                                <dxg:GridColumn FieldName="ID" Visible="False"/>
                                                <dxg:GridColumn FieldName="ParentCategory" Visible="False"/>
                                                <dxg:GridColumn FieldName="CategoryID" Header="Category ID" VisibleIndex="0"/>
                                                <dxg:GridColumn FieldName="Description" Header="Category Name" VisibleIndex="1"/>
                                            </dxg:GridControl.Columns>
                                            <dxg:GridControl.View>
                                                <dxg:TreeListView KeyFieldName="ID" ParentFieldName="ParentCategory" TreeDerivationMode="Selfreference" NavigationStyle="Row" ShowFilterPanelMode="Never" AllowColumnFiltering="False" AutoExpandAllNodes="True"/>
                                            </dxg:GridControl.View>
                                        </dxg:GridControl>
                                    </ControlTemplate>
                                </dxg:LookUpEdit.PopupContentTemplate>
                            </dxg:LookUpEdit>

                            <dxe:ToggleSwitch Grid.Row="7" Margin="1,27,0,-59" ContentPlacement="Far" HorizontalAlignment="Left" CheckedStateContent="Active?" Visibility="Collapsed" UncheckedStateContent="Active?" IsChecked="True" x:Name="chkActive" Checked="ChkActive_Checked" Unchecked="ChkActive_Checked"/>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnAdvance" Content="ADVANCED" 
                                    Style="{StaticResource LinkButtonStyle}" 
                                    Grid.Row="0" Grid.Column="1" 
                                    HorizontalAlignment="Right" 
                                    Margin="5,0,5,15" 
                                    FontSize="16"
                                    Click="btnAdvance_Click"/>

                            <Button x:Name="btnSave" Content="SAVE" 
                                    Style="{StaticResource SaveButtonStyleNew}" 
                                    Grid.Row="1" Grid.Column="0" 
                                    FontFamily="{StaticResource PoppinsRegular}" 
                                    Click="BtnLogin_Click"/>

                            <Button x:Name="btnCancel" Content="CANCEL" 
                                    Style="{StaticResource CancelButtonStyleNew}" 
                                    Grid.Row="1" Grid.Column="1" 
                                    Width="120" Margin="5,5,0,5" 
                                    FontFamily="{StaticResource PoppinsRegular}" 
                                    Click="BtnCancel_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </cc:ModalWindow>
        </Grid>
    </Grid>
</Window>