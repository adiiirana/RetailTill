                                        <RadioButton Visibility="Collapsed" x:Name="btnCheckInOut" Click="btnCheckInOut_Click">
                                            <RadioButton.Content>
                                                <TextBlock  Text="Check In/Out"/>
                                            </RadioButton.Content>
                                        </RadioButton>
                                        <RadioButton Visibility="Collapsed" x:Name="btnPointToStoreCredit" Click="btnPointToStoreCredit_Click">
                                            <RadioButton.Content>
                                                <TextBlock  Text="Points to Store Credit"/>
                                            </RadioButton.Content>
                                        </RadioButton>
                                        <RadioButton Visibility="Collapsed" x:Name="btnLottoPayout" Click="btnLottoPayout_Click">
                                            <RadioButton.Content>
                                                <TextBlock  Text="Lotto Payout"/>
                                            </RadioButton.Content>
                                        </RadioButton>
                                    </WrapPanel>
                                </ScrollViewer>

                                <Grid Grid.Column="4" VerticalAlignment="Center" Margin="0,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="7"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                Style="{DynamicResource PadNumericButtonStyleBlue}" Width="72" Height="42"
                            x:Name="UpScrollButton" Click="UpScrollButton_Click">
                                        <Image Source="{StaticResource UpCyan}" Width="18" Height="18"/>
                                    </Button>
                                    <Button Grid.Row="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                Style="{DynamicResource PadNumericButtonStyleBlue}" Height="42"
                            x:Name="DownScrollButton" Click="DownScrollButton_Click">
                                        <Image Source="{StaticResource DownCyan}" Width="18" Height="18"/>
                                    </Button>
                                </Grid>

                            </Grid>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
        <Grid Background="#3D000000" x:Name="blurGrid" Visibility="Collapsed"/>
        <Grid Background="#3D000000" x:Name="menuGrid" Visibility="Collapsed" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="160"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <DockPanel Background="Transparent" Grid.Column="0" x:Name="dummyDockPanel" PreviewMouseLeftButtonDown="dummyDockPanel_PreviewMouseLeftButtonDown"></DockPanel>
            <Image Source="{DynamicResource POSCloseMenu}" Visibility="Collapsed" Height="100" Width="100" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-20" PreviewMouseLeftButtonDown="Image_PreviewMouseLeftButtonDown" ></Image>

            <DockPanel Grid.Column="2" Style="{DynamicResource AdminMenuHeaderMainBackground}"  x:Name="pnlMenuHeaderD" Grid.RowSpan="3" Margin="0,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Image Source="{DynamicResource Online}" HorizontalAlignment="Right" Margin="3,0,3,0"></Image>
                    <WrapPanel Grid.Row="1" Orientation="Vertical" Width="150" x:Name="MenuPanelD" >
                        <DockPanel Style="{DynamicResource AdminMenuHeaderBackground}" Height="50"  VerticalAlignment="Bottom" x:Name="mnuLogoutD" Tag="0" Width="150" PreviewMouseLeftButtonDown="MnuLogout_PreviewMouseLeftButtonDown" >
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <cc:CustomButton x:Name="bmLogoutD" Grid.Column="1" Style="{DynamicResource POSLogout}" Margin="9,0,1,0" ></cc:CustomButton>
                                <TextBlock  Grid.Column="0" Text="Log out"  FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource OSBold}" Padding="10" Foreground="White" FontSize="12"></TextBlock>

                            </Grid>

                        </DockPanel>
                        <DockPanel Style="{DynamicResource AdminMenuHeaderBackground}" Height="50"  VerticalAlignment="Bottom" x:Name="mnuPOSD" Tag="0" Width="160" PreviewMouseLeftButtonDown="MnuPOS_PreviewMouseLeftButtonDown" >
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <cc:CustomButton x:Name="bmPOSD" Grid.Column="1" Style="{DynamicResource POSCart}" Margin="9,0,10,0" ></cc:CustomButton>
                                <TextBlock  Grid.Column="0" Text="Point of Sale"  FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource OSBold}" Padding="10" Foreground="White" FontSize="12" ></TextBlock>

                            </Grid>

                        </DockPanel>

                        <DockPanel Style="{DynamicResource AdminMenuHeaderBackground}" Height="50"  VerticalAlignment="Bottom" x:Name="mnuCustomerD" Tag="0" Width="160" PreviewMouseLeftButtonDown="MnuCustomer_PreviewMouseLeftButtonDown">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <cc:CustomButton x:Name="bmCustomerD" Grid.Column="1" Style="{DynamicResource POSCustomer}" Margin="9,0,10,0" ></cc:CustomButton>
                                <TextBlock  Grid.Column="0" Text="Customers"  FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource OSBold}" Padding="10" Foreground="White" FontSize="12"></TextBlock>

                            </Grid>

                        </DockPanel>

                        <DockPanel Style="{DynamicResource AdminMenuHeaderBackground}" Height="50"  VerticalAlignment="Bottom" x:Name="mnuItemD" Tag="0" Width="160" PreviewMouseLeftButtonDown="MnuItem_PreviewMouseLeftButtonDown">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <cc:CustomButton x:Name="bmItemD" Grid.Column="1" Style="{DynamicResource POSItem}" Margin="9,0,10,0" ></cc:CustomButton>
                                <TextBlock Grid.Column="0" Text="Items"  FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource OSBold}" Padding="10" Foreground="White" FontSize="12"></TextBlock>

                            </Grid>

                        </DockPanel>

                        <DockPanel Style="{DynamicResource AdminMenuHeaderBackground}" Height="50"  VerticalAlignment="Bottom" x:Name="mnuSetupD" Tag="0" Width="160" PreviewMouseLeftButtonDown="MnuSetup_PreviewMouseLeftButtonDown" >
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <cc:CustomButton x:Name="bmSetupD" Grid.Column="1" Style="{DynamicResource POSSetup}" Margin="9,0,10,0" ></cc:CustomButton>
                                <TextBlock  Grid.Column="0" Text="Setup"  FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource OSBold}" Padding="10" Foreground="White" FontSize="12"></TextBlock>

                            </Grid>

                        </DockPanel>

                        <DockPanel Style="{DynamicResource AdminMenuHeaderBackground}" Height="50"  VerticalAlignment="Bottom" x:Name="mnuRCTD" Tag="0" Width="160" PreviewMouseLeftButtonDown="MnuRCT_PreviewMouseLeftButtonDown" >
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="bmRCTD"  Grid.Column="1" Style="{DynamicResource POSPrinterIcon_1}" Margin="9,0,10,0" >
                                    <TextBlock FontWeight="Heavy" FontSize="13" TextAlignment="Center" Foreground="White">RCT</TextBlock>
                                </ToggleButton>
                                <TextBlock  Grid.Column="0" Text="Receipt Printer"  FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource OSBold}" Padding="5" Foreground="White" FontSize="12"></TextBlock>

                            </Grid>

                        </DockPanel>

                        <DockPanel Style="{DynamicResource AdminMenuHeaderBackground}" Height="50"  VerticalAlignment="Bottom" x:Name="mnuWeightD" Tag="0" Width="160" PreviewMouseLeftButtonDown="MnuWeight_PreviewMouseLeftButtonDown" >
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <cc:CustomButton x:Name="bmWeightD" Grid.Column="1" Style="{DynamicResource POSWeight}" Margin="9,0,10,0" ></cc:CustomButton>
                                <TextBlock  Grid.Column="0" Text="Weighted Products"  FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource OSBold}" Padding="5" Foreground="White" FontSize="12"></TextBlock>

                            </Grid>

                        </DockPanel>


                    </WrapPanel>
                    <Grid Grid.Row="2" Panel.ZIndex="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="0"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="DarkBlue" BorderThickness="1" Background="DarkBlue" PreviewMouseLeftButtonDown="BtnECHeaderD_PreviewMouseLeftButtonDown" >

                            <Canvas Height="30"  Panel.ZIndex="6">
                                <cc:CustomButton Style="{DynamicResource MenuShowhidestyleNew}"   Width="30" Height="30" Canvas.Left="0" Canvas.Top="0" x:Name="btnECHeaderD" >
                                    <Grid Margin="-30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            <ColumnDefinition Width="3"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Hide" Grid.Column="2" x:Name="lbShowHideHD" FontSize="12" FontFamily="{StaticResource OSRegular}" Foreground="White" Margin="-10,-6,0,0"></TextBlock>
                                        <Image Source="{StaticResource UpCyan}"  VerticalAlignment="Center" HorizontalAlignment="Right" Width="12" Height="12" Stretch="Uniform" Margin="12,15,0,23" x:Name="imghideD" Visibility="Visible" >
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform/>
                                                    <SkewTransform/>
                                                    <RotateTransform Angle="90"/>
                                                    <TranslateTransform/>
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                        </Image>

                                    </Grid>
                                </cc:CustomButton>


                            </Canvas>
                        </Border>

                        <DockPanel Grid.Row="2" Background="#64343B" Height="50" VerticalAlignment="Bottom" x:Name="mnuExitD" PreviewMouseLeftButtonDown="MnuExit_PreviewMouseLeftButtonDown" >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Exit" VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="{StaticResource OSRegular}" Padding="10" Foreground="White" FontSize="12"></TextBlock>
                                <Image Source="{DynamicResource ExitMenu}" Grid.Column="2" Width="21" Height="21"  Margin="3,0,10,0"></Image>

                            </Grid>

                        </DockPanel>
                    </Grid>
                </Grid>
            </DockPanel>

        </Grid>
    </Grid>
</UserControl>
