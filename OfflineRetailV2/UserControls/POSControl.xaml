<UserControl x:Class="OfflineRetailV2.UserControls.POSControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:local="clr-namespace:OfflineRetailV2.UserControls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              
             
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
              xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
               xmlns:dxre="http://schemas.devexpress.com/winfx/2008/xaml/richedit"
             xmlns:posSec="clr-namespace:OfflineRetailV2.UserControls.POSSection"
             xmlns:administrator="clr-namespace:OfflineRetailV2.UserControls.Administrator"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"  
              mc:Ignorable="d" 
             xmlns:cc="clr-namespace:OfflineRetailV2.Controls" IsVisibleChanged="UserControl_IsVisibleChanged_1" d:DesignWidth="1024" d:DesignHeight="768" Focusable="True" IsTabStop="True" Loaded="UserControl_Loaded"  >
    <!--Width="1024" Height="768"-->
    <UserControl.Resources>
        <ResourceDictionary>
            <dxre:HtmlToContentConverter x:Key="htmlToContentConverter"></dxre:HtmlToContentConverter>
            <dxre:RtfToContentConverter x:Key="rtfToContentConverter" />
            <Style x:Key="richEditStyle" TargetType="dxre:RichEditControl">

                <Setter Property="ShowBorder" Value="false"/>
                <Setter Property="ActiveViewType" Value="Simple"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Collapsed"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Collapsed"/>
            </Style>

            <Style TargetType="Border" x:Key="borderStyle">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="True">
                        <Setter Property="Visibility" Value="Visible"></Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type dxg:NoRecordsControl}" x:Key="{dxgt:TableViewThemeKey ResourceKey=NoRecordsControlStyle, IsThemeIndependent=true}">
                <!--!!!-->
                <Style.Resources>
                    <dxg:DynamicLocalizationStringValueConvertor x:Key="LocalizationStringValueConverter" />
                </Style.Resources>
                <Setter Property="NoRecordsFoundText" Value="{Binding Path=DataControl.View.LocalizationDescriptor, Converter={StaticResource LocalizationStringValueConverter}, ConverterParameter=NoRecordsFound, RelativeSource={RelativeSource Self}}" />
                <Setter Property="NoRecordsText"  Value="{Binding Path=DataControl.View.LocalizationDescriptor, Converter={StaticResource LocalizationStringValueConverter}, ConverterParameter=NoRecords, RelativeSource={RelativeSource Self}}" />
                <!--!!!-->

                <Setter Property="DataControl" Value="{Binding Path=(dxg:GridControl.CurrentView).DataControl, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="Foreground" Value="{DynamicResource {dxgt:TableViewThemeKey ResourceKey=NoRecordsForeground}}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Opacity" Value="1.00" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type dxg:NoRecordsControl}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="noRecordsTxt"
                                           Text="{TemplateBinding NoRecordsFoundText}" />
                                <Button Margin="3,0"
                                        Command="{Binding DataContext.MyCommand,
                                                          ElementName=MyWindowInstance}"
                                        Content="TEST BUTTON" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding NoRecords,
                                                               RelativeSource={RelativeSource Self}}"
                                             Value="True">
                                    <Setter TargetName="noRecordsTxt" Property="Text" Value="{Binding NoRecordsText, RelativeSource={RelativeSource TemplatedParent}}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>


            <!--<Style TargetType="dxg:GridControl">
                <Setter Property="Background" Value="Black" />
            </Style>-->

            <!--<Style  TargetType="{x:Type dxg:RowControl}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectionState}" Value="None">
                        <Setter Property="Background" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>-->

            <ControlTemplate x:Key="{dxgt:TableViewThemeKey ResourceKey=DataPresenterTemplate}" TargetType="{x:Type dxg:DataPresenter}">
                <Border Background="Red">
                    <ContentPresenter />
                </Border>
            </ControlTemplate>
            <Style x:Key="RowStyle" TargetType="{x:Type dxg:GridRowContent}">
                <Setter Property="Background" Value="Red" />
            </Style>

            <!--<ControlTemplate xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"  
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"  
                 x:Key="{dxgt:GridControlThemeKey ResourceKey=BorderTemplate, IsThemeIndependent=True}"  
                 TargetType="{x:Type ContentControl}">
                <Border Background="White">
                    <Border.Padding>
                        <Binding Path="(dxg:GridBorderHelper.ShowBorder)" RelativeSource="{RelativeSource TemplatedParent}">
                            <Binding.Converter>
                                <dx:BoolToObjectConverter FalseValue="0" TrueValue="1" />
                            </Binding.Converter>
                        </Binding>
                    </Border.Padding>
                    <Border  Style="{DynamicResource WhiteBackcolor}"  >
                        <ContentPresenter />
                    </Border>
                </Border>
            </ControlTemplate>-->

            <local:CartQtyDisplayConverter x:Key="CartQtyDisplayConverter"/>
            <local:CartHtmlToTextConverter x:Key="CartHtmlToTextConverter"/>

            <Style x:Key="ConvCartCircleBtnStyle" TargetType="Button">
                <Setter Property="Width" Value="25"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid SnapsToDevicePixels="True">
                                <Ellipse x:Name="ring" Stroke="{DynamicResource ConvCartAccentBlue}" StrokeThickness="1.4" Fill="Transparent"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ring" Property="Fill" Value="{DynamicResource ConvCartBtnBlueHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ring" Property="Fill" Value="{DynamicResource ConvCartBtnBluePressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ConvCartDeleteBtnStyle" TargetType="Button" BasedOn="{StaticResource ConvCartCircleBtnStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid SnapsToDevicePixels="True">
                                <Ellipse x:Name="ring" Stroke="{DynamicResource ConvCartAccentRed}" StrokeThickness="1.4" Fill="Transparent"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ring" Property="Fill" Value="{DynamicResource ConvCartBtnRedHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ring" Property="Fill" Value="{DynamicResource ConvCartBtnRedPressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ConvActionBtnStyle" TargetType="Button">
                <Setter Property="Height" Value="42"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="6" BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ConvActionVoidBtnStyle" TargetType="Button" BasedOn="{StaticResource ConvActionBtnStyle}">
                <Setter Property="Background" Value="{DynamicResource ConvActionVoidFill}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ConvActionVoidAccent}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ConvActionVoidHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ConvActionVoidPressed}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ConvActionEditBtnStyle" TargetType="Button" BasedOn="{StaticResource ConvActionBtnStyle}">
                <Setter Property="Background" Value="{DynamicResource ConvActionEditFill}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ConvActionEditAccent}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ConvActionEditHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ConvActionEditPressed}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ConvActionDiscountBtnStyle" TargetType="Button" BasedOn="{StaticResource ConvActionBtnStyle}">
                <Setter Property="Background" Value="{DynamicResource ConvActionDiscountFill}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ConvActionDiscountAccent}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ConvActionDiscountHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ConvActionDiscountPressed}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ConvNavBtnStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="btnFace" Width="42" Height="42" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Ellipse Fill="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                         Opacity="0.38" Margin="-6" IsHitTestVisible="False">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="10"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse x:Name="circle"
                                         Fill="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                         Stroke="{TemplateBinding BorderBrush}"
                                         StrokeThickness="{DynamicResource ConvNavStrokeThickness}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="{DynamicResource ConvNavShadowColor}"
                                                          BlurRadius="10" ShadowDepth="3" Direction="270"
                                                          Opacity="{DynamicResource ConvNavShadowOpacity}"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Margin="3,2,3,14" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#66FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse x:Name="hoverOverlay" Fill="{DynamicResource ConvNavHoverOverlay}"
                                         Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="hoverOverlay" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnFace" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.93" ScaleY="0.93"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="hoverOverlay" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ConvCartRowStyle" TargetType="{x:Type dxg:RowControl}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource ConvCartTextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectionState}" Value="None">
                        <Setter Property="Background" Value="Transparent"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectionState}" Value="1">
                        <Setter Property="Background" Value="{DynamicResource ConvCartRowSelectedBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectionState}" Value="Focused">
                        <Setter Property="Background" Value="{DynamicResource ConvCartRowSelectedBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectionState}" Value="Selected">
                        <Setter Property="Background" Value="{DynamicResource ConvCartRowSelectedBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectionState}" Value="FocusedAndSelected">
                        <Setter Property="Background" Value="{DynamicResource ConvCartRowSelectedBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>

    <Grid Style="{DynamicResource GrdBkColor}">
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition Height="0"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="2" x:Name="lbCompany"  VerticalAlignment="Center" FontSize="13" FontFamily="{StaticResource OSBold}"
                   Visibility="Collapsed" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <posSec:frmPOSMoreFunctionsControl x:Name="frmPOSMoreFunctionsControl" Visibility="Collapsed"/>
                <Grid Grid.Column="2" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2"/>
                        <!--<ColumnDefinition Width="375"/>-->
                        <!--<ColumnDefinition Width="10"/>-->
                        <ColumnDefinition Width="375" x:Name="colPOSCart"/>
                        <ColumnDefinition Width="10" x:Name="colConvenienceKeypad"/>
                        <ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" x:Name="col00"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>

                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="10,10,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="9"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="9"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="9"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Image Source="{DynamicResource Back}" Height="40" Width="40" x:Name="btnBack" PreviewMouseLeftButtonDown="BtnBack_PreviewMouseLeftButtonDown" ></Image>
                            <Button x:Name="btnBackConv" Style="{StaticResource ConvNavBtnStyle}"
                                    Background="{DynamicResource ConvNavBackFill}" BorderBrush="{DynamicResource ConvNavBackStroke}"
                                    Visibility="Collapsed" Cursor="Hand"
                                    PreviewMouseLeftButtonDown="BtnBack_PreviewMouseLeftButtonDown">
                                <Path Data="M20,11H7.83l5.59,-5.59L12,4l-8,8 8,8 1.41,-1.41L7.83,13H20V11z"
                                      Stretch="Uniform" Width="18" Height="18" Fill="{DynamicResource ConvNavBackIcon}"/>
                            </Button>
                            <Image Grid.Column="2" Source="{DynamicResource POSHome}" Height="40" Width="40" x:Name="btnHome" PreviewMouseLeftButtonDown="BtnHome_PreviewMouseLeftButtonDown"></Image>
                            <Button x:Name="btnHomeConv" Grid.Column="2" Style="{StaticResource ConvNavBtnStyle}"
                                    Background="{DynamicResource ConvNavHomeFill}" BorderBrush="{DynamicResource ConvNavHomeStroke}"
                                    Visibility="Collapsed" Cursor="Hand"
                                    PreviewMouseLeftButtonDown="BtnHome_PreviewMouseLeftButtonDown">
                                <Path Data="M10,20 V14 H14 V20 H19 V12 H22 L12,3 2,12 H5 V20 Z"
                                      Stretch="Uniform" Width="18" Height="18" Fill="{DynamicResource ConvNavHomeIcon}"/>
                            </Button>

                            <cc:CustomTextBox Grid.Column="4" VerticalAlignment="Center"  HorizontalAlignment="Stretch" Height="30"  BorderThickness="1"  CornerRadius="0" MaxLength="50"
                                  InfoText="Search"  Icon="{DynamicResource Search}" FontSize="13"  FontFamily="{DynamicResource OSSemiBold}"  x:Name="txtSearch" LostFocus="TxtSearch_LostFocus" TextChanged="TxtSearch_TextChanged" PreviewKeyDown="Find_PreviewKeyDown" PreviewMouseDown="TxtSearch_MouseDown"  />

                            <dxe:ComboBoxEdit Grid.Column="6" x:Name="cmbSaleType" Width="115" Height="30" IsTextEditable="False" VerticalAlignment="Center"
                                              SelectedIndex="0" SelectedIndexChanged="CmbSaleType_SelectedIndexChanged"
                                              FontFamily="{StaticResource OSSemiBold}" FontSize="13" Foreground="White" 
                                              Background="#800080" BorderThickness="0" BorderBrush="Transparent">
                                <dxe:ComboBoxEditItem Content="Counter Sale"/>
                                <dxe:ComboBoxEditItem Content="Account Sale"/>
                            </dxe:ComboBoxEdit>
                        </Grid>

                        <TabControl Grid.Row="1"   x:Name="tcPOS" Visibility="Visible"
                    Style="{DynamicResource OuterPOSTabControlStyle}" SelectionChanged="tcPOS_SelectionChanged"
                                Margin="-6,-2,3,0" >
                            <TabItem Header="POS" x:Name="POSTItem" Width="100"
             Style="{DynamicResource OuterPOSTabItemStyle}" Visibility="Collapsed">
                                <Grid Margin="0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="187*"/>
                                        <ColumnDefinition Width="465*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="0"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <dxg:GridControl SelectionMode="Row" x:Name="grdTax" Visibility="Collapsed" Grid.ColumnSpan="2" Margin="0,0,0,2" Grid.RowSpan="2">
                                        <dxg:GridControl.View>
                                            <dxg:TableView x:Name="gridView2"/>
                                        </dxg:GridControl.View>
                                        <dxg:GridColumn x:Name="colTaxName" FieldName="Tax" Header="Tax" Width="*" HorizontalHeaderContentAlignment="Center"
                                Visible="False"/>
                                        <dxg:GridColumn x:Name="colTaxAmount" FieldName="Amount" Header="Amout" Width="*" HorizontalHeaderContentAlignment="Center"
                                Visible="False">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings DisplayFormat="f" MaskType="Numeric"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn x:Name="gridColumn1" FieldName="TaxID" Header="gridColumn1" Width="*" HorizontalHeaderContentAlignment="Center"
                                Visible="False"/>
                                        <dxg:GridColumn x:Name="colDTax" FieldName="DTax" Header="DTax" Width="*" HorizontalHeaderContentAlignment="Center"
                                Visible="False"/>
                                    </dxg:GridControl>

                                    <dxg:GridControl SelectionMode="Row" x:Name="grdTaxQT" Visibility="Collapsed" Grid.ColumnSpan="2" Margin="0,0,0,2" Grid.RowSpan="2">
                                        <dxg:GridControl.View>
                                            <dxg:TableView x:Name="gridView3"/>
                                        </dxg:GridControl.View>
                                        <dxg:GridColumn x:Name="colTaxID" FieldName="TAXID" Header="TaxID" Width="*" HorizontalHeaderContentAlignment="Center"
                                Visible="False"/>
                                        <dxg:GridColumn x:Name="gridColumn3" FieldName="Amount" Header="Amout" Width="*" HorizontalHeaderContentAlignment="Center"
                                Visible="False">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings DisplayFormat="f" MaskType="Numeric"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn x:Name="gridColumn2" FieldName="Tax" Header="Tax" Width="*" HorizontalHeaderContentAlignment="Center"
                                Visible="False"/>
                                        <dxg:GridColumn x:Name="gridColumn4" FieldName="DTax" Header="DTax" Width="*" HorizontalHeaderContentAlignment="Center"
                                Visible="False"/>
                                    </dxg:GridControl>

                                    <Grid Grid.Row="0" Background="#763E98"  x:Name="pnlInfo" Margin="0,0,0,2" Visibility="Collapsed" Grid.ColumnSpan="2" Grid.RowSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="13"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="13"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" x:Name="lbClerk" FontFamily="{StaticResource OSSemiBold}" FontSize="13" Text="Clerk # ADMIN" />
                                        <TextBlock Grid.Column="3" x:Name="lbRedTop" FontFamily="{StaticResource OSSemiBold}" FontSize="13" Text="Invoice #11"/>
                                        <TextBlock Grid.Column="5" x:Name="lbTime" FontFamily="{StaticResource OSSemiBold}" FontSize="13" Text="5:19 PM"/>
                                    </Grid>
                                    <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Category Label -->
                                            <RowDefinition Height="*"/>
                                            <!-- One ScrollViewer with everything -->
                                        </Grid.RowDefinitions>

                                        <!-- Category Label -->
                                        <Grid Grid.Row="0" x:Name="pnlCategory" Visibility="Collapsed" Margin="9">
                                            <TextBlock x:Name="lbCategory" FontFamily="{DynamicResource OSSemiBold}" FontSize="16"/>
                                        </Grid>

                                        <!-- ✅ One ScrollViewer containing everything -->
                                        <ScrollViewer  
                                            dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap"
                                            ManipulationBoundaryFeedback="Posscroll_ManipulationBoundaryFeedback"
                                            Grid.Row="1" 
                                            x:Name="posScroll"
                                            Style="{DynamicResource ThickScroll}"  
                                            HorizontalScrollBarVisibility="Disabled" 
                                            VerticalScrollBarVisibility="Auto" 
                                            PanningMode="Both" 
                                            Margin="0" 
                                            VerticalAlignment="Stretch">

                                            <!-- ✅ A StackPanel to hold the canvases and banner vertically -->
                                            <StackPanel Orientation="Vertical" Margin="0">
                                                <!-- NEW CONVENIENCE VIEW TABS -->
                                                <Grid x:Name="pnlConvenienceTabs" Visibility="Collapsed" Margin="10,0,10,15">
                                                    <Grid.Resources>
                                                        <Style x:Key="UnderlineTabStyle" TargetType="RadioButton">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
                                                            <Setter Property="FontFamily" Value="{DynamicResource OSBold}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="FontSize" Value="11"/>
                                                            <Setter Property="Height" Value="40"/>
                                                            <Setter Property="Cursor" Value="Arrow"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="RadioButton">
                                                                        <Grid Background="Transparent">
                                                                            <ContentPresenter x:Name="TabContent"
                                                                                              HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"
                                                                                              Margin="0,0,0,4"
                                                                                              Opacity="0.4"
                                                                                              RecognizesAccessKey="True"/>
                                                                            <Border x:Name="ActiveBorder"
                                                                                    BorderThickness="0,0,0,3"
                                                                                    BorderBrush="#3B82F6"
                                                                                    VerticalAlignment="Bottom"
                                                                                    Visibility="Hidden"/>
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                                                                <Setter TargetName="TabContent" Property="Opacity" Value="1"/>
                                                                                <Setter TargetName="ActiveBorder" Property="Visibility" Value="Visible"/>
                                                                            </Trigger>
                                                                            <MultiTrigger>
                                                                                <MultiTrigger.Conditions>
