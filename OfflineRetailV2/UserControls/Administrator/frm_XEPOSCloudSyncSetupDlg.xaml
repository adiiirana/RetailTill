<Window x:Class="OfflineRetailV2.UserControls.Administrator.frm_XEPOSCloudSyncSetupDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OfflineRetailV2.UserControls.Administrator"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:lm="clr-namespace:OfflineRetailV2.LayoutManager"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Title=""
        Foreground="White"
        Loaded="Window_Loaded"
        Closing="Window_Closing" Width="650" Height="500">

    <cc:ModalWindow x:Name="ModalWindow">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <!-- Title -->
                <RowDefinition Height="50"/>
                <!-- Toggle -->
                <RowDefinition Height="*"/>
                
                <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock
                       Text="XEPOS Cloud Sync Settings"
                       x:Name="Title"
                       VerticalAlignment="Center"
                       Style="{DynamicResource BlueHeading}" Margin="7,0,-7,0" />

            <!-- Separator and Toggle -->
            <Grid Grid.Row="1"  >
                <Grid.RowDefinitions>
                    <RowDefinition Height="15"/>
                    <!-- Title -->
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Rectangle Grid.Row="0"
                           Style="{DynamicResource DefaultLineStyle}"
                           VerticalAlignment="Center" Width="570"/>

                <dxe:ToggleSwitch Grid.Row="1"                                  
                                  ContentPlacement="Far"
                                  HorizontalAlignment="Left"
                                  UncheckedStateContent="Register New Business"
                                  CheckedStateContent="Already Registered Business"
                                  x:Name="chkBusinessExist"
                                  Checked="chkBusinessExist_Checked"
                                  Unchecked="chkBusinessExist_Unchecked"  />
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="2" x:Name="MainContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    
                </Grid.RowDefinitions>

                <!-- Business Setup -->
                <Border Grid.Row="0" Style="{DynamicResource GreenBorder}">
                    <TextBlock Style="{DynamicResource GreenBorderInfo}"
                               Text="Business Detail"/>
                </Border>
                <!-- Sign-Up Panel -->
                <Grid Grid.Row="2" x:Name="BusinessSetupGrid" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <!-- Business Name - shown before Email when toggle is unchecked, hidden when checked (will show in Store section) -->
                    <TextBlock Grid.Row="0" Grid.Column="0" x:Name="lblBusinessName" 
                               VerticalAlignment="Center" Height="20" Margin="10,0,0,0"> 
                        <Run Foreground="Red">*</Run>
                        <Run Text=" Business Name :" ></Run>
                    </TextBlock>
                    <dxe:TextEdit Grid.Row="0" Grid.Column="2" x:Name="txtBusinessName" 
                                  MaxLength="50" Height="32" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Height="20" Margin="10,0,0,0">
                        <Run Foreground="Red">*</Run>
                        <Run Text=" Email :" ></Run>
                    </TextBlock>

                    <TextBox x:Name="hdID" Text="MyHiddenValue" Visibility="Hidden"/>
                    <dxe:TextEdit Grid.Row="2" Grid.Column="2" x:Name="txtEmail" 
                                  MaxLength="100" Height="32" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="hdStoreID" Text="MyHiddenValue" Visibility="Hidden"/>


                    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Height="20" Margin="10,0,0,0">
                        <Run Foreground="Red">*</Run>
                        <Run Text=" Password :" ></Run>
                    </TextBlock>
                    <dxe:PasswordBoxEdit Grid.Row="4" Grid.Column="2" x:Name="txtPassword" 
                                         MaxLength="20" Height="32" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <!--<TextBlock Grid.Row="6" Grid.Column="0" >
                        <Run Foreground="Red">*</Run>
                        <Run Text=" Confirm Password :" ></Run>
                    </TextBlock>
                    <dxe:PasswordBoxEdit Grid.Row="6" Grid.Column="2" x:Name="txtConfirmPassword"
                                         Height="32" MaxLength="20"
                                         GotFocus="Full_GotFocusPswd"
                                         LostFocus="Full_LostFocus"/>-->



                    <Button Grid.Row="7" Grid.Column="1" IsEnabled="False"
                         x:Name="btnRegisterBusiness"
                         Style="{DynamicResource SaveButtonStyle}"
                         Content="Register Business"
                         Height="32" Width="410"
                         Click="btnRegisterBusiness_Click" Margin="9,4,10,4" Grid.ColumnSpan="2"/>

                </Grid>

                <Border Grid.Row="4" Style="{DynamicResource OrangeBorder}" x:Name="gcco3111" >
                    <TextBlock Style="{DynamicResource OrangeBorderInfo}" Text="Store Detail"/>
                </Border>
                <Grid Grid.Row="6" x:Name="gcco223" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" x:Name="rowBusinessName"/>
                        <RowDefinition Height="10" x:Name="rowBusinessNameSpacer"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        
                    </Grid.RowDefinitions>

                    <!-- Business Name - shown before Store Name when toggle is checked -->
                    <TextBlock Grid.Row="0" Grid.Column="0" x:Name="lblBusinessNameStore" 
                               Visibility="Collapsed" VerticalAlignment="Center" Height="20" Margin="10,0,0,0"> 
                        <Run Foreground="Red">*</Run>
                        <Run Text=" Business Name :" ></Run>
                    </TextBlock>
                    <dxe:TextEdit Grid.Row="0" Grid.Column="2" x:Name="txtBusinessNameStore" 
                                  MaxLength="50" Visibility="Collapsed" Height="32" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Height="20" Margin="10,0,0,0">
                        <Run Text=" Select Store : "></Run>
                    </TextBlock>

                    <ComboBox x:Name="cmbExistingStores" SelectionChanged="cmbExistingStores_SelectionChanged"
                       Grid.Row="2" Grid.Column="2"
                       Background="#FFF8F8"
                       Foreground="Black"
                       BorderBrush="#FFE0E0E0"
                       Padding="6,2"
                       Height="32"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center"
                       Margin="0,0,10,0"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Height="20" Margin="10,0,0,0">
                        <Run Foreground="Red">*</Run>
                        <Run Text=" Store Name :" ></Run>
                    </TextBlock>
                    <dxe:TextEdit Grid.Row="4" Grid.Column="2" x:Name="txtStoreName"
                         Height="32" 
                         VerticalAlignment="Center"
                         Margin="0,0,10,0"
                         GotFocus="Full_GotFocus"
                         LostFocus="Full_LostFocus"></dxe:TextEdit>

                    <Button x:Name="btnRegisterStore"
         Grid.Row="6" Grid.Column="1"
         Width="410"
         HorizontalAlignment="Left"
         VerticalAlignment="Center"
         IsEnabled="False"
         Style="{DynamicResource SaveButtonStyle}"
         Content="Register / Connect Store"
         Click="btnRegisterStore_Click" Grid.ColumnSpan="2" Margin="9,0,0,0" />

                    <Button x:Name="btnLogout"
         Grid.Row="6" Grid.Column="1"
         Grid.ColumnSpan="2" Margin="9,4,10,4"
         Width="410"
         Visibility="Collapsed"
         Content="Logout"
         Style="{DynamicResource CancelButtonStyle}"
         Click="btnLogout_Click"/>
                </Grid>
            </Grid>

            <!-- Footer Buttons -->

        </Grid>
    </cc:ModalWindow>
</Window>
